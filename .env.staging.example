# ============================================================================
# Expload Marketing SaaS — STAGING Environment
# ============================================================================
# Copy to .env.staging. Staging uses the exact same docker-compose.prod.yml
# and Dockerfile as production (that's the point of staging — verify the
# real deployment path, not a different one) with a separate domain,
# separate secrets, and separate Postgres/Redis data:
#
#   docker compose -f docker-compose.prod.yml --env-file .env.staging \
#     -p expload-staging up -d --build
#
# (the `-p expload-staging` project-name flag keeps its containers/volumes
# fully separate from a production stack possibly running on the same
# host — omit it if staging lives on its own host entirely.)
#
# Every variable below is the same set docker-compose.prod.yml reads —
# see .env.production.example for what each one does. This file exists
# only to make the *intended differences* explicit, not to document them
# twice.
# ============================================================================

# --- Named environment label — tags every structured log line/alert as
# "staging", not "production" (NODE_ENV itself will still say
# "production" — see src/lib/config/env.ts's getDeployEnv() for why) ---
DEPLOY_ENV=staging

# --- REQUIRED: Domain & TLS — MUST be different from production's ---
DOMAIN=staging.your-domain.com

# --- REQUIRED: Database — a separate Postgres volume/database from prod,
# never the same instance ---
POSTGRES_USER=marketing
POSTGRES_PASSWORD=
POSTGRES_DB=marketing_saas_staging

# --- REQUIRED: Redis — separate from prod ---
REDIS_PASSWORD=

# --- REQUIRED: Auth — a DIFFERENT secret from production's. Never reuse
# a production NEXTAUTH_SECRET here: a staging session token must never
# be valid against the production app or vice versa. ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=
NEXT_PUBLIC_APP_URL=

# --- Observability — staging is where you'd actually want debug-level
# logs and a real ALERT_WEBHOOK_URL pointed at a non-paging channel, since
# this is exactly the environment for catching a bug before it's a
# production incident. ---
LOG_LEVEL=debug
ALERT_WEBHOOK_URL=
METRICS_TOKEN=

# --- Everything else (SMTP/SMS/LLM providers/Serper/Qdrant/crypto
# payment/Playwright/SIEM/PUBLIC_LANDING) — same variables as
# .env.production.example. Real recommendation for staging specifically:
# use TEST-MODE credentials wherever a provider offers them (most payment
# gateways and many LLM providers do) so a staging run can never move real
# money or burn a production API quota. Leave blank to exercise each
# feature's documented fail-soft fallback instead — this project never
# fabricates success when a real integration isn't configured, so an
# empty staging config is a legitimate, safe way to test everything
# EXCEPT those specific integrations. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com
SMS_API_URL=
SMS_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
HUGGINGFACE_API_KEY=
SERPER_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CRYPTO_GATEWAY=nowpayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_WEBHOOK_SECRET=
PLATFORM_WALLET_BTC_BITCOIN=
PLATFORM_WALLET_ETH_ETHEREUM=
PLATFORM_WALLET_USDT_TRON=
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_EXTRACT_REVIEWS=false
SIEM_WEBHOOK_URL=
PUBLIC_LANDING=true
