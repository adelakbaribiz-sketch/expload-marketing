# Production Caddyfile — now a real docker-compose SERVICE
# (docker-compose.prod.yml's `caddy`), not a script-generated host-level
# install. Phase 19 (DevOps & Deployment): the previous approach —
# scripts/deploy-vps.sh installing Caddy via `apt` on the host and
# heredoc-generating this exact same config over SSH — worked, but meant
# the reverse proxy sat outside the `docker compose up` reproducibility
# story every other service already had. Containerizing it means the
# whole stack (app+postgres+redis+caddy) comes up from one command on any
# host with Docker, with nothing to configure by hand first.
#
# Security note (fixed 2026-09-05, preserved from the prior version of
# this file): an earlier version listened on plain HTTP :81 with an
# unauthenticated `?XTransformPort=<n>` open-proxy handler — removed
# outright, never reintroduced here.
#
# DOMAIN comes from .env.production (see .env.production.example) — Caddy
# substitutes {$DOMAIN} at startup and only issues a real Let's Encrypt
# certificate for a real registered domain pointed at this host, not a bare
# IP. (No ACME_EMAIL is configured — Caddy's ACME registration works
# without one; add a global `{ email {$ACME_EMAIL} }` block above the site
# block, plus the matching env var in docker-compose.prod.yml and
# .env.production.example, if renewal-failure notifications are wanted.)

{$DOMAIN} {
  reverse_proxy app:3000 {
    header_up Host {host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Real-IP {remote_host}
  }

  header {
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
  }

  encode gzip zstd

  @static path /_next/static/* /fonts/* /images/* /favicon.ico
  header @static Cache-Control "public, max-age=31536000, immutable"
}
