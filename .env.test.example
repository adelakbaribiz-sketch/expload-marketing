# ============================================================================
# Expload Marketing SaaS — TEST (CI) Environment
# ============================================================================
# This is what .github/workflows/ci.yml actually runs against (its `env:`
# block inlines these same values directly in the workflow file, since
# they're not secrets — a CI-only NEXTAUTH_SECRET protects nothing real).
# This file exists so the exact same setup can be reproduced locally:
#
#   cp .env.test.example .env
#   bun run db:generate && bun run db:push
#   bun test && bun run db:integrity-check && bun run security-check
#
# Every other env var (LLM providers, SMTP, payment gateways, etc.) is
# deliberately left unset here — the whole point of running against a
# minimal environment in CI is to prove the app's fail-soft fallbacks
# actually work when nothing is configured, not to test against a
# fully-provisioned environment (that's what a real staging run is for).
# ============================================================================

DATABASE_URL=file:./db/custom.db
NODE_ENV=test
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=ci-only-secret-not-used-in-production-please-change-32chars
