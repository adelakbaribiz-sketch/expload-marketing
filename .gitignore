# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# user-uploaded files (private local storage adapter — see src/lib/storage)
/storage/private/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — but NOT the .env.*.example templates, which are meant to be
# committed (placeholder values only, no real secrets) so a fresh clone has
# something to `cp` from. Found Phase 19: this blanket pattern had silently
# excluded every .env*.example file from this repo's entire git history,
# including the pre-existing .env.example — a fresh `git clone` had none of
# the files every deploy script and doc tells you to copy.
.env*
!.env*.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# local SQLite dev database
/db/*.db
/db/*.db-journal
/prisma/db/*.db
/prisma/db/*.db-journal