// Autonomous Marketing SaaS - Multi-tenant schema
// Supports SQLite (dev) and PostgreSQL (production) — just change the
// datasource provider and DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
  // For PostgreSQL production deployment:
  //   provider = "postgresql"
  //   url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  isActive  Boolean  @default(true)
  plan      String   @default("free") // free | pro | enterprise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                       User[]
  activities                  Activity[]
  projects                    Project[]
  leads                       Lead[]
  contacts                    Contact[]
  companies                   Company[]
  campaigns                   EmailCampaign[]
  templates                   EmailTemplate[]
  deals                       Deal[]
  pipelines                   Pipeline[]
  tasks                       Task[]
  seoProjects                 SeoProject[]
  contentIdeas                ContentIdea[]
  contentPieces               ContentPiece[]
  socialAccounts              SocialAccount[]
  adAccounts                  AdAccount[]
  analyticsEvents             AnalyticsEvent[]
  analyticsReports            AnalyticsReport[]
  aiAgents                    AiAgent[]
  aiDecisions                 AiDecision[]
  workflows                   Workflow[]
  backlinkOpportunities       BacklinkOpportunity[]
  authorityTrackers           AuthorityTracker[]
  socialAnalyses              SocialAnalysis[]
  competitorProfiles          CompetitorProfile[]
  exportMarkets               ExportMarket[]
  exportProducts              ExportProduct[]
  marketResearch              MarketResearch[]
  whatsappMessages            WhatsAppMessage[]
  whatsappTemplates           WhatsAppTemplate[]
  chatbotConversations        ChatbotConversation[]
  reviewMonitors              ReviewMonitor[]
  abTestExperiments           AbTestExperiment[]
  landingPages                LandingPage[]
  monthlyReports              MonthlyReport[]
  businessDiagnostics         BusinessDiagnostic[]
  chatbotWidgets              ChatbotWidget[]
  agentCycles                 AgentCycle[]
  subscription                Subscription?
  invoices                    Invoice[]
  goals                       Goal[]
  onboardingSteps             OnboardingStep[]
  calendarEvents              CalendarEvent[]
  teamInvitations             TeamInvitation[]
  approvalRequests            ApprovalRequest[]
  notifications               Notification[]
  brandMentions               BrandMention[]
  brandKeywords               BrandKeyword[]
  pricingCalculations         PricingCalculation[]
  progressiveUnlock           ProgressiveUnlock?
  apiKeys                     ApiKey[]
  clubMembership              ClubMembership?
  clubAdvertisements          ClubAdvertisement[]
  ecommerceProducts           EcommerceProduct[]
  resellerApplications        ResellerApplication[]
  profitEstimates             ProfitEstimate[]
  attributionEvents           AttributionEvent[]
  fraudRules                  FraudRule[]
  cohorts                     Cohort[]
  marketingFunnels            MarketingFunnel[]
  customerJourneys            CustomerJourney[]
  pushNotifications           PushNotification[]
  smsMessages                 SmsMessage[]
  webhookSubscriptions        WebhookSubscription[]
  roles                       Role[]
  auditLogs                   AuditLogEntry[]
  projectMembers              ProjectMember[]
  whiteLabelConfig            WhiteLabelConfig?
  resellerCustomers           ResellerCustomer[]           @relation("ResellerCustomers")
  commissions                 Commission[]                 @relation("CommissionsEarned")
  payments                    Payment[]
  paymentMethods              PaymentMethod[]
  financialAlerts             FinancialAlert[]
  referrerReferrals           Referral[]                   @relation("ReferrerTenant")
  refereeReferrals            Referral[]                   @relation("RefereeTenant")
  customerOfResellers         ResellerCustomer[]           @relation("CustomerOfReseller")
  promoLinks                  PromoLink[]
  competitorAnalyses          CompetitorAnalysis[]
  investorProfiles            InvestorProfile[]
  cofounderProfiles           CofounderProfile[]
  partnershipOpportunities    PartnershipOpportunity[]
  // Wholesale distribution & internal staff
  distributor                 Distributor?
  cryptoPayments              CryptoPayment[]
  cryptoWallets               CryptoWallet[]
  financialReports            FinancialReport[]
  // Multi-LLM & negotiation
  onboardingSessions          OnboardingSession[]
  negotiationSessions         NegotiationSession[]
  llmUsageRecords             LlmUsageRecord[]
  // Virtual assistants, payroll, support, vector search
  assistantAssignments        AssistantAssignment[]
  supportSubscriptions        SupportSubscription[]
  supportTickets              SupportTicketItem[]
  vectorIndices               VectorIndex[]
  // Project briefs + campaign schedules + demos
  projectBriefs               ProjectBrief[]
  campaignScheduleSuggestions CampaignScheduleSuggestion[]
  sandboxSessions             SandboxSession[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  hashedPassword String?
  role           String   @default("member") // owner | admin | manager | editor | viewer
  isActive       Boolean  @default(true)
  tenantId       String
  roleId         String? // links to Role model for granular permissions
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRole       Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activities       Activity[]
  campaigns        EmailCampaign[]
  emailTemplates   EmailTemplate[]
  contentPieces    ContentPiece[]
  projectMembers   ProjectMember[]
  superAdmin       SuperAdmin?
  internalEmployee InternalEmployee?

  @@index([tenantId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active") // active | paused | archived
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads   Lead[]
  members ProjectMember[]

  @@index([tenantId])
}

model Company {
  id        String   @id @default(cuid())
  name      String
  website   String?
  industry  String?
  address   String?
  phone     String?
  size      String? // e.g. "11-50"
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads    Lead[]
  contacts Contact[]
  deals    Deal[]

  @@index([tenantId])
}

model Lead {
  id           String   @id @default(cuid())
  name         String
  email        String?
  phone        String?
  website      String?
  address      String?
  industry     String?
  description  String?
  services     String? // JSON-serialized list of services
  rating       Float? // Google Maps rating (0-5)
  reviewsCount Int? // Number of Google Maps reviews
  score        Float    @default(0)
  status       String   @default("new") // new | contacted | qualified | won | lost
  source       String? // serper | maps | manual | ai
  tenantId     String
  projectId    String?
  companyId    String?
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activities Activity[]
  emailLogs  EmailLog[]
  deals      Deal[]

  @@index([tenantId, status])
  @@index([email])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  position  String?
  tenantId  String
  companyId String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals Deal[]

  @@index([tenantId])
  @@index([email])
}

model Activity {
  id        String   @id @default(cuid())
  type      String // created | updated | contacted | enriched | scored | auth | email_sent
  message   String
  userId    String?
  leadId    String?
  tenantId  String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // The one tenantId in the schema with no @relation to Tenant, unlike its
  // ~75 sibling models (and unlike this row's own userId/leadId fields
  // above) — found via scripts/db-integrity-check.ts flagging 50 real
  // orphaned rows in the live dev DB (dangling tenantId pointing at an
  // already-deleted Tenant, since DELETE /api/tenants/[id] had nothing to
  // cascade through here). See RELIABILITY-AUDIT.md's sibling finding
  // class and QA-AUDIT.md for this one.
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ============================================================================
// Phase 2: Email Marketing
// ============================================================================

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  body      String // HTML or plain text body with {{variables}}
  design    String? // JSON-serialized design (for future visual editor)
  category  String   @default("general") // general | welcome | follow_up | newsletter | promotional
  tenantId  String
  createdBy String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator   User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns EmailCampaign[]
}

model EmailCampaign {
  id              String         @id @default(cuid())
  name            String
  subject         String
  body            String // Snapshot of template body at send time
  status          String         @default("draft") // draft | scheduled | sending | sent | failed | cancelled
  recipientFilter String? // JSON: { status, industry, minScore, projectId }
  recipientCount  Int            @default(0)
  sentCount       Int            @default(0)
  openCount       Int            @default(0)
  clickCount      Int            @default(0)
  bounceCount     Int            @default(0)
  scheduledAt     DateTime?
  sentAt          DateTime?
  tenantId        String
  templateId      String?
  createdBy       String?
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template        EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  creator         User?          @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  logs EmailLog[]

  // Measured (PERFORMANCE-AUDIT.md): every real query against this model
  // filters by tenantId (list, counts, monthly-report range queries), yet
  // this was the one model in the schema with zero @@index entries at
  // all — every other tenant-scoped, list/date-sorted model already
  // follows this [tenantId, createdAt] pattern from Phase 04's indexing
  // pass.
  @@index([tenantId, createdAt])
}

model EmailLog {
  id          String        @id @default(cuid())
  campaignId  String
  leadId      String?
  to          String // recipient email
  status      String        @default("pending") // pending | sent | delivered | opened | clicked | bounced | failed
  error       String?
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  campaign    EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([campaignId])
  @@index([leadId])
  @@index([status])
}

// ============================================================================
// Phase 3: CRM Domain — Contacts, Companies, Deals, Pipelines
// ============================================================================

model Deal {
  id                String    @id @default(cuid())
  title             String
  value             Float     @default(0)
  currency          String    @default("USD")
  stage             String    @default("lead") // lead | qualified | proposal | negotiation | won | lost
  probability       Int       @default(0) // 0-100
  expectedCloseDate DateTime?
  closedAt          DateTime?
  tenantId          String
  leadId            String?
  contactId         String?
  companyId         String?
  projectId         String?
  ownerId           String?
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead              Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact           Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
  @@index([stage])
}

model Pipeline {
  id        String   @id @default(cuid())
  name      String
  stages    String // JSON array: ["lead", "qualified", "proposal", "negotiation", "won", "lost"]
  tenantId  String
  isDefault Boolean  @default(false)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("todo") // todo | in_progress | done | cancelled
  priority    String    @default("medium") // low | medium | high | urgent
  dueDate     DateTime?
  completedAt DateTime?
  tenantId    String
  assigneeId  String?
  leadId      String?
  dealId      String?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
}

// ============================================================================
// Phase 4: SEO Domain — Crawls, Pages, Issues, Keywords, Backlinks
// ============================================================================

model SeoProject {
  id             String    @id @default(cuid())
  name           String
  domain         String
  tenantId       String
  crawlFrequency String    @default("weekly") // daily | weekly | monthly
  lastCrawlAt    DateTime?
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  crawls    SeoCrawl[]
  pages     SeoPage[]
  issues    SeoIssue[]
  keywords  SeoKeyword[]
  backlinks SeoBacklink[]
}

model SeoCrawl {
  id           String     @id @default(cuid())
  seoProjectId String
  status       String     @default("pending") // pending | running | completed | failed
  pagesCrawled Int        @default(0)
  issuesFound  Int        @default(0)
  duration     Int? // seconds
  startedAt    DateTime?
  completedAt  DateTime?
  seoProject   SeoProject @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([seoProjectId])
}

model SeoPage {
  id              String     @id @default(cuid())
  seoProjectId    String
  url             String
  title           String?
  metaDescription String?
  h1Count         Int        @default(0)
  h2Count         Int        @default(0)
  wordCount       Int        @default(0)
  loadTime        Float? // seconds
  mobileFriendly  Boolean    @default(false)
  hasSchema       Boolean    @default(false)
  hasSitemap      Boolean    @default(false)
  score           Int        @default(0) // 0-100
  seoProject      SeoProject @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)
  crawledAt       DateTime   @default(now())

  @@index([seoProjectId])
  @@index([url])
}

model SeoIssue {
  id           String     @id @default(cuid())
  seoProjectId String
  pageUrl      String
  type         String // missing_h1 | missing_meta | broken_link | slow_load | no_schema | no_mobile
  severity     String     @default("warning") // info | warning | error | critical
  message      String
  resolved     Boolean    @default(false)
  seoProject   SeoProject @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([seoProjectId])
  @@index([severity])
  @@index([resolved])
}

model SeoKeyword {
  id           String     @id @default(cuid())
  seoProjectId String
  keyword      String
  position     Int? // SERP position
  searchVolume Int? // monthly searches
  difficulty   Int? // 0-100
  cpc          Float? // cost per click
  trend        String? // JSON array of positions over time
  seoProject   SeoProject @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([seoProjectId])
  @@index([keyword])
}

model SeoBacklink {
  id              String     @id @default(cuid())
  seoProjectId    String
  sourceUrl       String
  targetUrl       String
  anchorText      String?
  domainAuthority Int? // 0-100
  pageAuthority   Int? // 0-100
  linkType        String     @default("dofollow") // dofollow | nofollow
  status          String     @default("active") // active | lost | broken
  firstSeen       DateTime   @default(now())
  lastChecked     DateTime   @default(now())
  seoProject      SeoProject @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)

  @@index([seoProjectId])
  @@index([status])
}

// ============================================================================
// Phase 3 (Strategy): Content Domain — Ideas, Pieces, Calendar
// ============================================================================

model ContentIdea {
  id          String   @id @default(cuid())
  title       String
  description String?
  topic       String?
  contentType String   @default("blog") // blog | video | social | infographic | podcast
  keywords    String? // JSON array
  source      String   @default("manual") // manual | ai | competitor | trend
  status      String   @default("idea") // idea | approved | in_progress | published | archived
  aiScore     Int? // 0-100, AI-predicted engagement score
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pieces ContentPiece[]
}

model ContentPiece {
  id          String       @id @default(cuid())
  title       String
  body        String // The actual content (markdown/HTML)
  excerpt     String?
  contentType String       @default("blog")
  wordCount   Int          @default(0)
  status      String       @default("draft") // draft | reviewed | scheduled | published
  aiGenerated Boolean      @default(false)
  seoScore    Int? // 0-100
  tenantId    String
  ideaId      String?
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  idea        ContentIdea? @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  createdBy   String?
  creator     User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  calendar ContentCalendar[]
}

model ContentCalendar {
  id             String       @id @default(cuid())
  contentPieceId String
  platform       String // blog | linkedin | twitter | facebook | instagram
  scheduledAt    DateTime
  publishedAt    DateTime?
  status         String       @default("scheduled") // scheduled | publishing | published | failed
  contentPiece   ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  tenantId       String
  createdAt      DateTime     @default(now())

  @@index([scheduledAt])
  @@index([status])
  @@index([tenantId])
}

// ============================================================================
// Phase 6: Social Media Domain
// ============================================================================

model SocialAccount {
  id            String   @id @default(cuid())
  platform      String // linkedin | twitter | facebook | instagram | youtube
  handle        String
  displayName   String?
  avatarUrl     String?
  followerCount Int?
  isConnected   Boolean  @default(true)
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posts SocialPost[]
}

model SocialPost {
  id              String        @id @default(cuid())
  socialAccountId String
  content         String
  mediaUrls       String? // JSON array
  status          String        @default("draft") // draft | scheduled | published | failed
  likes           Int           @default(0)
  comments        Int           @default(0)
  shares          Int           @default(0)
  impressions     Int           @default(0)
  reach           Int           @default(0)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  tenantId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([tenantId])
}

// ============================================================================
// Phase 5: Ads Domain
// ============================================================================

model AdAccount {
  id        String   @id @default(cuid())
  platform  String // google_ads | meta_ads | tiktok_ads | linkedin_ads
  accountId String
  name      String
  currency  String   @default("USD")
  isConnect Boolean  @default(true)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns AdCampaign[]
}

model AdCampaign {
  id          String    @id @default(cuid())
  adAccountId String
  name        String
  status      String    @default("draft") // draft | active | paused | completed
  budget      Float     @default(0)
  budgetType  String    @default("daily") // daily | lifetime
  spend       Float     @default(0)
  impressions Int       @default(0)
  clicks      Int       @default(0)
  conversions Int       @default(0)
  ctr         Float? // click-through rate
  cpc         Float? // cost per click
  cpa         Float? // cost per acquisition
  roas        Float? // return on ad spend
  startDate   DateTime?
  endDate     DateTime?
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([tenantId])
}

// ============================================================================
// Phase 8: Analytics Domain
// ============================================================================

model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventType  String // page_view | click | conversion | signup | purchase
  eventName  String
  properties String? // JSON
  userId     String?
  sessionId  String?
  pageUrl    String?
  referrer   String?
  userAgent  String?
  ip         String?
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([eventType])
  @@index([createdAt])
}

model AnalyticsReport {
  id        String   @id @default(cuid())
  name      String
  type      String // funnel | summary | cohort | retention | custom
  config    String // JSON: { metrics, dimensions, filters, dateRange }
  data      String? // JSON: computed results (cached)
  schedule  String? // daily | weekly | monthly (for auto-refresh)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// Phase 9: AI Agents Domain
// ============================================================================

model AiAgent {
  id          String   @id @default(cuid())
  name        String
  type        String // strategy | advisor | autonomous | content | seo | ads
  description String?
  config      String? // JSON: { model, temperature, systemPrompt, tools }
  isActive    Boolean  @default(true)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks           AiTask[]
  recommendations AiRecommendation[]
}

model AiTask {
  id          String    @id @default(cuid())
  agentId     String
  type        String // analyze | generate | recommend | execute
  input       String // JSON
  output      String? // JSON
  status      String    @default("pending") // pending | running | completed | failed
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  agent       AiAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenantId    String
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([tenantId])
}

model AiRecommendation {
  id          String   @id @default(cuid())
  agentId     String
  category    String // seo | content | ads | social | email | strategy
  priority    String   @default("medium") // low | medium | high | critical
  title       String
  description String
  actionData  String? // JSON: actionable steps
  impact      String? // estimated impact
  status      String   @default("pending") // pending | approved | rejected | implemented
  agent       AiAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([tenantId])
}

// ============================================================================
// Workflow Engine
// ============================================================================

model Workflow {
  id            String   @id @default(cuid())
  name          String
  description   String?
  trigger       String // manual | scheduled | event
  triggerConfig String? // JSON: { schedule, event, conditions }
  steps         String // JSON array: [{ id, type, config, next }]
  isActive      Boolean  @default(true)
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runs WorkflowRun[]

  @@index([tenantId])
}

model WorkflowRun {
  id          String    @id @default(cuid())
  workflowId  String
  status      String    @default("pending") // pending | running | completed | failed | cancelled
