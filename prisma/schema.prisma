  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([tenantId])
