// ============================================================================
// Promo Link Generator — Online Marketing Link Builder
// ============================================================================

model PromoLink {
  id           String    @id @default(cuid())
  // Short link
  shortCode    String    @unique
  shortUrl     String // e.g. https://expload.io/p/abc123
  // Destination
  targetUrl    String // the actual URL to redirect to
  // UTM parameters
  utmSource    String? // e.g. newsletter, facebook, google
  utmMedium    String? // e.g. email, cpc, social
  utmCampaign  String? // e.g. summer_sale, launch_week
  utmTerm      String?
  utmContent   String? // e.g. banner_top, text_link
  // Metadata
  name         String // user-friendly name
  description  String?
  category     String    @default("general") // social | email | ads | blog | affiliate | qr | general
  tags         String? // JSON array
  // QR Code
  qrCodeUrl    String? // generated QR code image URL
  qrCodeColor  String    @default("#0A2A3A")
  qrCodeSize   Int       @default(300)
  // Tracking
  totalClicks  Int       @default(0)
  uniqueClicks Int       @default(0)
  conversions  Int       @default(0)
  // Click analytics (JSON: [{ date, count, country, device, source }])
  clickData    String? // JSON array
  // A/B testing
  variantLabel String? // A | B | C
  // Expiration
  expiresAt    DateTime?
  // Status
  isActive     Boolean   @default(true)
  // Ownership
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById  String?
  // Timestamps
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clicks PromoLinkClick[]

  @@index([tenantId])
  @@index([category])
  @@index([isActive])
}

model PromoLinkClick {
  id              String    @id @default(cuid())
  promoLinkId     String
  promoLink       PromoLink @relation(fields: [promoLinkId], references: [id], onDelete: Cascade)
  // Visitor info
  ipAddress       String?
  userAgent       String?
  referer         String?
  country         String?
  city            String?
  device          String? // desktop | mobile | tablet
  browser         String?
  os              String?
  // Conversion tracking
  converted       Boolean   @default(false)
  conversionValue Float?
  // Timestamp
  clickedAt       DateTime  @default(now())

  @@index([promoLinkId])
  @@index([clickedAt])
  @@index([country])
}

// ============================================================================
// Competitor Deep Analysis (8+ factor analysis)
// ============================================================================

model CompetitorAnalysis {
  id                       String            @id @default(cuid())
  // Link to CompetitorProfile
  competitorId             String
  competitor               CompetitorProfile @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  // 1. Content & Topics
  contentType              String? // educational | vlog | comedy | review | tutorial | news | entertainment
  contentFormats           String? // JSON array: ["video","blog","podcast","infographic"]
  topicDiversity           String? // focused | diverse | multi_niche
  topTopics                String? // JSON array of top topics
  titleKeywords            String? // JSON: most used words in titles
  descriptionStyle         String? // detailed | minimal | keyword_stuffed | storytelling
  // 2. Upload Frequency
  postsPerWeek             Float?
  postsPerMonth            Int?
  uploadSchedule           String? // JSON: { days: ["Mon","Wed"], hours: [9, 15, 18] }
  consistencyScore         Int? // 0-100
  // 3. Engagement
  avgLikes                 Int?
  avgComments              Int?
  avgShares                Int?
  engagementRate           Float? // percentage (likes+comments+shares / views * 100)
  commentResponseRate      Float? // percentage of comments they reply to
  avgResponseTime          String? // e.g. "2 hours", "1 day"
  // 4. Quantitative Metrics
  avgViews                 Int?
  peakViews                Int?
  subscriberGrowth         Float? // percentage monthly growth
  avgWatchTime             String? // e.g. "4:32"
  ctr                      Float? // click-through rate percentage
  totalSubscribers         Int?
  // 5. SEO & Optimization
  seoKeywords              String? // JSON array
  tagStrategy              String? // optimized | basic | none
  descriptionOptimized     Boolean?
  usesEndCards             Boolean?
  usesPlaylists            Boolean?
  internalLinking          String? // JSON: strategy description
  // 6. Thumbnails & Design
  thumbnailStyle           String? // text_overlay | face_shot | product_shot | minimal | bold_colors
  visualConsistency        Int? // 0-100
  colorScheme              String? // JSON: dominant colors
  usesBranding             Boolean?
  // 7. Target Audience
  audienceAgeRange         String? // e.g. "18-24", "25-34"
  audienceGender           String? // male | female | mixed
  audienceCountries        String? // JSON: top countries
  toneOfVoice              String? // formal | casual | humorous | professional | inspirational
  languageUsed             String?
  // 8. Sponsorships & Monetization
  hasSponsorships          Boolean           @default(false)
  sponsorBrands            String? // JSON array
  hasAffiliateLinks        Boolean           @default(false)
  affiliatePrograms        String? // JSON: ["Amazon","ClickBank"]
  monetizationMethods      String? // JSON: ["ads","sponsorship","merch","courses","membership"]
  estimatedMonthlyEarnings Float?
  // 9. Cross-Platform Presence
  platforms                String? // JSON: { instagram: "url", twitter: "url", tiktok: "url" }
  crossPlatformStrategy    String? // how they funnel audience
  totalFollowersAll        Int? // combined followers across platforms
  // 10. SWOT
  strengths                String? // JSON array
  weaknesses               String? // JSON array
  uniqueSellingPoints      String? // JSON array
  improvementOpportunities String? // JSON: what you can do better
  // AI Analysis
  aiAnalysis               String? // JSON: { summary, recommendations, threat_level, opportunity_score }
  analysisDate             DateTime          @default(now())
  tenantId                 String
  tenant                   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([competitorId])
  @@index([tenantId])
}

// ============================================================================
// Investor & Co-founder Matching System
// ============================================================================

model InvestorProfile {
  id                 String    @id @default(cuid())
  // Investor info
  name               String
  email              String?
  linkedin           String?
  avatar             String?
  bio                String?
  // Investment profile
  investorType       String // angel | seed | vc | pe | corporate | accelerator
  firmName           String?
  // Investment criteria
  stages             String? // JSON: ["pre-seed","seed","series-a"]
  sectors            String? // JSON: ["SaaS","AI","Fintech","E-commerce","Marketing"]
  checkSize          String? // e.g. "$50K-$500K"
  geography          String? // e.g. "Global", "Middle East", "US"
  ticketSize         Float? // USD
  // Portfolio
  portfolioCompanies String? // JSON: [{ name, sector, stage }]
  portfolioCount     Int       @default(0)
  // Stats
  totalInvested      Float     @default(0)
  successRate        Float? // percentage
  // Matching
  matchScore         Int? // 0-100 match with current tenant
  matchReasons       String? // JSON: why they match
  // Status
  isVerified         Boolean   @default(false)
  isActive           Boolean   @default(true)
  // Contact
  contactStatus      String    @default("not_contacted") // not_contacted | contacted | responded | meeting_scheduled | deal
  lastContactAt      DateTime?
  // Ownership
  tenantId           String?
  tenant             Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

