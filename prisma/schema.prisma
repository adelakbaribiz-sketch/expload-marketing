// ============================================================================
// RBAC: Roles, Permissions, Project Members, Super Admin
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  name        String // owner | admin | manager | editor | viewer | super_admin
  displayName String
  description String?
  level       Int      @default(0) // 0=viewer, 1=editor, 2=manager, 3=admin, 4=owner, 5=super_admin
  isSystem    Boolean  @default(false)
  isDefault   Boolean  @default(false)
  scope       String   @default("tenant") // tenant | project
  color       String   @default("#0A2A3A")
  icon        String   @default("👤")
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  members     ProjectMember[]
  users       User[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  category    String   @default("general")
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model ProjectMember {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleId            String?
  role              Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  customPermissions String?
  status            String    @default("active") // active | invited | suspended
  invitedAt         DateTime  @default(now())
  joinedAt          DateTime?
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
}

model SuperAdmin {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       Int      @default(1)
  permissions String   @default("[]")
  isActive    Boolean  @default(true)
  assignedBy  String?
  assignedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLogEntry {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  userRole    String?
  action      String
  entityType  String
  entityId    String?
  entityName  String?
  ipAddress   String?
  userAgent   String?
  changes     String?
  description String
  severity    String   @default("info")
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([severity])
  @@index([createdAt])
}

// ============================================================================
// White Label & Grey Label System
// ============================================================================

model WhiteLabelConfig {
  id                  String    @id @default(cuid())
  tenantId            String    @unique
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Label type
  labelType           String    @default("grey") // white | grey | co_branded
  // Branding
  brandName           String
  brandLogoUrl        String?
  brandFaviconUrl     String?
  brandColors         String? // JSON: { primary, accent, background }
  // Domain
  customDomain        String? // e.g. marketing.reseller.com
  customSubdomain     String? // e.g. reseller.expload.io
  // Email
  supportEmail        String?
  fromEmail           String?
  // Features toggle
  hideExploadBranding Boolean   @default(false)
  hideBlogSection     Boolean   @default(false)
  hidePricingCalc     Boolean   @default(false)
  customFooterText    String?
  // Reseller settings
  isReseller          Boolean   @default(false)
  resellerTier        String    @default("standard") // standard | premium | enterprise
  commissionRate      Float     @default(20) // percentage
  customPricing       String? // JSON: { starter: 39, growth: 149, enterprise: 399 }
  // Limits
  maxSubTenants       Int       @default(10)
  maxStorage          Int       @default(1000) // MB
  // Status
  isActive            Boolean   @default(true)
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model ResellerCustomer {
  id               String    @id @default(cuid())
  // Parent reseller
  resellerTenantId String
  resellerTenant   Tenant    @relation("ResellerCustomers", fields: [resellerTenantId], references: [id], onDelete: Cascade)
  // Customer's own tenant
  customerTenantId String
  customerTenant   Tenant    @relation("CustomerOfReseller", fields: [customerTenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Pricing (reseller sets custom price)
  monthlyFee       Float     @default(49)
  currency         String    @default("USD")
  // Commission
  commissionRate   Float     @default(20)
  commissionEarned Float     @default(0)
  // Status
  status           String    @default("active") // active | suspended | churned | trial
  trialEndsAt      DateTime?
  activatedAt      DateTime  @default(now())
  suspendedAt      DateTime?
  churnedAt        DateTime?
  // Revenue tracking
  totalRevenue     Float     @default(0)
  totalPaid        Float     @default(0)
  // Timestamps
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([resellerTenantId, customerTenantId])
  @@index([resellerTenantId])
  @@index([customerTenantId])
  @@index([status])
}

model Commission {
  id               String    @id @default(cuid())
  resellerTenantId String
  resellerTenant   Tenant    @relation("CommissionsEarned", fields: [resellerTenantId], references: [id], onDelete: Cascade)
  customerTenantId String?
  // Commission details
  amount           Float
  currency         String    @default("USD")
  type             String // new_customer | renewal | upgrade | referral
  status           String    @default("pending") // pending | paid | void
  // Payment period
  periodStart      DateTime
  periodEnd        DateTime
  paidAt           DateTime?
  // Metadata
  description      String?
  createdAt        DateTime  @default(now())

  @@index([resellerTenantId])
  @@index([status])
}

// ============================================================================
// Payment System
// ============================================================================

model Payment {
  id                    String    @id @default(cuid())
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Payment details
  amount                Float
  currency              String    @default("USD")
  type                  String // subscription | one_time | topup | commission | refund
  status                String    @default("pending") // pending | completed | failed | refunded | disputed
  // Stripe
  stripePaymentIntentId String?
  stripeChargeId        String?
  // Invoice
  invoiceId             String?
  invoiceNumber         String?
  // Payment method
  paymentMethod         String? // card | bank_transfer | paypal | crypto
  paymentMethodId       String?
  // Metadata
  description           String?
  failureReason         String?
  // Fee tracking
  processingFee         Float     @default(0)
  netAmount             Float     @default(0)
  // Reseller commission
  commissionAmount      Float     @default(0)
  resellerTenantId      String?
  // Timestamps
  initiatedAt           DateTime  @default(now())
  completedAt           DateTime?
  refundedAt            DateTime?
  createdAt             DateTime  @default(now())

  cryptoPayments        CryptoPayment[]

  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId, status])
}

model PaymentMethod {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Method details
  type                  String // card | bank_account | paypal
  provider              String   @default("stripe") // stripe | paypal | manual
  // Card info (masked)
  brand                 String? // visa | mastercard | amex
  last4                 String?
  expiryMonth           Int?
  expiryYear            Int?
  holderName            String?
  // Stripe
  stripePaymentMethodId String?
  stripeCustomerId      String?
  // Status
  isDefault             Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tenantId])
}

model FinancialAlert {
  id              String    @id @default(cuid())
  tenantId        String?
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  // Alert details
  type            String // low_balance | failed_payment | churn_risk | revenue_milestone | payment_overdue | subscription_expiring | high_usage | commission_due
  severity        String    @default("warning") // info | warning | critical
  title           String
  message         String
  // Thresholds
  thresholdValue  Float?
  currentValue    Float?
  // Action
  actionUrl       String?
  actionLabel     String?
  // Status
  isRead          Boolean   @default(false)
  isResolved      Boolean   @default(false)
  resolvedAt      DateTime?
  // Platform-level alert (null tenantId = platform-wide)
  isPlatformAlert Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([type])
  @@index([severity])
  @@index([isRead])
  @@index([isPlatformAlert])
}

// ============================================================================
// Platform Self-Promotion Engine
// ============================================================================

model PlatformPromotion {
  id             String    @id @default(cuid())
  name           String
  type           String // email_campaign | social_post | blog_post | ad_campaign | referral_program | affiliate | seo_content | pr_release
  // Campaign details
  title          String
  description    String?
  content        String? // JSON: { body, html, socialText, ... }
  // Targeting
  targetAudience String? // all | trial_users | churned | prospects | resellers | affiliates
  targetSegments String? // JSON array
  // Scheduling
  scheduledAt    DateTime?
  launchedAt     DateTime?
  // Metrics
  impressions    Int       @default(0)
  clicks         Int       @default(0)
  conversions    Int       @default(0)
  revenue        Float     @default(0)
  // Status
  status         String    @default("draft") // draft | scheduled | active | completed | paused
  // Auto-generated by AI
  isAiGenerated  Boolean   @default(false)
  aiPrompt       String?
  // Timestamps
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([type])
  @@index([status])
  @@index([targetAudience])
}

model ReferralProgram {
  id                    String   @id @default(cuid())
  name                  String
  // Referral config
  referrerReward        Float    @default(50) // USD credit
  refereeReward         Float    @default(50) // USD credit
  rewardType            String   @default("credit") // credit | cash | months_free | percentage
  // Rules
  minSpend              Float    @default(0) // referee must spend this much before reward
  maxReferrals          Int? // null = unlimited
  expiresAfterDays      Int? // null = no expiry
  // Status
  isActive              Boolean  @default(true)
  // Stats
  totalReferrals        Int      @default(0)
  totalRewardsPaid      Float    @default(0)
  totalRevenueGenerated Float    @default(0)
  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  referrals Referral[]
}

model Referral {
  id                 String          @id @default(cuid())
  programId          String
  program            ReferralProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  // Referrer (existing customer)
  referrerTenantId   String
  referrerTenant     Tenant          @relation("ReferrerTenant", fields: [referrerTenantId], references: [id], onDelete: Cascade)
  // Referee (new customer)
  refereeEmail       String
  refereeTenantId    String?
  refereeTenant      Tenant?         @relation("RefereeTenant", fields: [refereeTenantId], references: [id], onDelete: SetNull)
  // Tracking
  referralCode       String          @unique
  status             String          @default("pending") // pending | signed_up | qualified | rewarded | expired
  // Reward tracking
  referrerRewardPaid Boolean         @default(false)
  refereeRewardPaid  Boolean         @default(false)
  // Revenue from this referral
  totalRevenue       Float           @default(0)
  // Timestamps
  invitedAt          DateTime        @default(now())
  signedUpAt         DateTime?
  qualifiedAt        DateTime?
  rewardedAt         DateTime?

  @@index([programId])
  @@index([referrerTenantId])
  @@index([refereeEmail])
  @@index([status])
