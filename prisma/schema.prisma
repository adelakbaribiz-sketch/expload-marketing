model PartnershipOpportunity {
  id               String   @id @default(cuid())
  title            String
  description      String
  // Partnership type
  type             String // strategic | technical | marketing | distribution | co_development | joint_venture | reseller | affiliate
  // Partner info
  partnerName      String
  partnerType      String // startup | enterprise | agency | influencer | media | nonprofit
  partnerWebsite   String?
  partnerContact   String?
  // Details
  valueProposition String?
  expectedBenefit  String?
  estimatedValue   Float?
  timeline         String? // e.g. "3-6 months"
  requirements     String? // JSON array
  // Status
  status           String   @default("discovered") // discovered | evaluating | contacted | negotiating | active | rejected
  priority         String   @default("medium") // low | medium | high | critical
  matchScore       Int?
  // Timestamps
