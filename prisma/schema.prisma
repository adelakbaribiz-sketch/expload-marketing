  isFlagged      Boolean  @default(false)
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mentionedAt    DateTime
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([keyword])
  @@index([sentiment])
}

model BrandKeyword {
  id              String    @id @default(cuid())
  keyword         String
  isActive        Boolean   @default(true)
  alertOnPositive Boolean   @default(false)
  alertOnNegative Boolean   @default(true)
  alertOnNeutral  Boolean   @default(false)
  totalMentions   Int       @default(0)
  lastChecked     DateTime?
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([keyword, tenantId])
  @@index([tenantId])
}

// ============================================================================
// Pricing Calculator
// ============================================================================

model PricingCalculation {
  id                       String   @id @default(cuid())
  monthlyBudget            Float
  productPrice             Float
  reviewCount              Int
  reviewPlatforms          Int
  funnelLeads              Int
  funnelQualified          Float
  funnelDeals              Float
  recommendedPlan          String?
  estimatedMonthlyCost     Float?
  estimatedROI             Float?
  estimatedLeadsPerMonth   Int?
  estimatedRevenuePerMonth Float?
  customerEmail            String?
  customerName             String?
  tenantId                 String?
  tenant                   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt                DateTime @default(now())

  @@index([recommendedPlan])
}

// ============================================================================
// Progressive Unlock System — phases unlock based on plan + budget + time
// ============================================================================

model ProgressiveUnlock {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  // Which phases are unlocked (JSON: { "P1": true, "P2": true, ... })
  unlockedPhases  String   @default("[]") // JSON array: ["P1","P2",...]
  // Current active phase
  currentPhase    String   @default("P1")
  // Progress within current phase (0-100)
  phaseProgress   Int      @default(0)
  // Overall platform progress (0-100)
  overallProgress Int      @default(0)
  // Plan-based unlock schedule
  plan            String   @default("starter") // starter | growth | enterprise
  // Budget-based acceleration
  monthlyBudget   Float    @default(0)
  // Signup date (for time-based unlocking)
  signupDate      DateTime @default(now())
  // Unlock history (JSON: [{ phase, unlockedAt, trigger }])
  unlockHistory   String? // JSON array
  // Roadmap milestones
  milestones      String? // JSON: [{ phase, title, description, targetDate, completed }]
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================================
// Blog / Content (Public SEO content)
// ============================================================================

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String
  content         String // Markdown content
  htmlContent     String? // Pre-rendered HTML cache
  // Metadata
  category        String    @default("Marketing") // Marketing | SEO | Lead Gen | AI | Social | Ads | Strategy
  tags            String? // JSON array
  coverImage      String?
  author          String    @default("Expload Team")
  authorAvatar    String?
  // SEO
  metaTitle       String?
  metaDescription String?
  keywords        String? // JSON array
  // Status
  status          String    @default("published") // draft | published | archived
  featured        Boolean   @default(false)
  // Stats
  viewCount       Int       @default(0)
  likeCount       Int       @default(0)
  readTime        Int       @default(5) // minutes
  // Dates
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  comments BlogComment[]

  @@index([status])
  @@index([category])
  @@index([featured])
  @@index([publishedAt])
}

model BlogComment {
  id          String   @id @default(cuid())
  postId      String
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String?
  content     String
  status      String   @default("pending") // pending | approved | spam
  createdAt   DateTime @default(now())

  @@index([postId])
  @@index([status])
}

// ============================================================================
// Live Demo — tracks anonymous demo sessions
// ============================================================================

model DemoSession {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  // Which demo view the user is exploring
  currentView  String    @default("dashboard") // dashboard | leads | generator | seo | analytics
  // Interactions count for analytics
  interactions Int       @default(0)
  // Whether they converted to signup
  converted    Boolean   @default(false)
  convertedAt  DateTime?
  // Metadata
  userAgent    String?
  referrer     String?
  country      String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())

  @@index([converted])
  @@index([createdAt])
}

// ============================================================================
// API Marketplace — sell API access to platform capabilities
// ============================================================================

model ApiProduct {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String
  // Pricing
  pricePerCall    Float    @default(0.01) // USD per API call
  pricePerMonth   Float    @default(0) // USD monthly subscription (0 = pay-per-call only)
  // Limits
  rateLimit       Int      @default(100) // calls per minute
  dailyLimit      Int      @default(10000) // calls per day
  // Metadata
  category        String   @default("marketing") // marketing | seo | leads | ai | social | analytics
  endpoint        String // e.g. "POST /api/v1/leads/search"
  method          String   @default("POST") // GET | POST | PUT | DELETE
  // Status
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  // Stats
  totalCalls      Int      @default(0)
  totalRevenue    Float    @default(0)
  subscriberCount Int      @default(0)
  // Documentation
  docContent      String? // Markdown documentation
  codeExamples    String? // JSON: [{ language, code }]
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  keys  ApiKey[]
  usage ApiUsage[]

  @@index([category])
  @@index([isActive])
}

model ApiKey {
  id               String    @id @default(cuid())
  key              String    @unique
  name             String // user-given name
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Linked products (empty = all products)
  productIds       String? // JSON array of ApiProduct IDs
  // Status
  isActive         Boolean   @default(true)
  revokedAt        DateTime?
  // Limits (override product defaults)
  customRateLimit  Int?
  customDailyLimit Int?
  // Usage stats
  totalCalls       Int       @default(0)
  totalCost        Float     @default(0)
  lastUsedAt       DateTime?
  // Billing
  billingCycle     String    @default("monthly") // monthly | prepaid
  balance          Float     @default(0) // prepaid balance in USD
  // Timestamps
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?

  products ApiProduct[]
  usage    ApiUsage[]

  @@index([tenantId])
  @@index([isActive])
}

model ApiUsage {
  id           String     @id @default(cuid())
  apiKeyId     String
  apiKey       ApiKey     @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  productId    String
  product      ApiProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Request details
  endpoint     String
  method       String
  statusCode   Int
  responseTime Int? // milliseconds
  // Billing
  cost         Float      @default(0)
  // Metadata
  ipAddress    String?
  userAgent    String?
  // Timestamp
  createdAt    DateTime   @default(now())

  @@index([apiKeyId])
  @@index([productId])
  @@index([createdAt])
}

// ============================================================================
// Customer Club (باشگاه مشتریان) — loyalty tiers, points, benefits, free ads
// ============================================================================

model ClubTier {
  id              String   @id @default(cuid())
  name            String // Bronze | Silver | Gold | Platinum
  level           Int      @default(1) // 1=Bronze, 2=Silver, 3=Gold, 4=Platinum
  // Requirements
  minSpend        Float    @default(0) // minimum total spend to qualify
  minMonths       Int      @default(0) // minimum months as customer
  // Benefits
  discountPct     Float    @default(0) // percentage discount on all services
  freeAdCredits   Int      @default(0) // free advertisement credits per month
  apiCallBonus    Int      @default(0) // bonus API calls per month
  prioritySupport Boolean  @default(false)
  earlyAccess     Boolean  @default(false) // early access to new features
  // Visual
  color           String   @default("#B0BEC5")
  icon            String   @default("🥉")
  description     String?
  // Status
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  memberships ClubMembership[]
}

model ClubMembership {
  id               String    @id @default(cuid())
  tenantId         String    @unique
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tierId           String
  tier             ClubTier  @relation(fields: [tierId], references: [id])
  // Points
  totalPoints      Int       @default(0)
  availablePoints  Int       @default(0)
  lifetimePoints   Int       @default(0)
  // Stats
  totalSpend       Float     @default(0)
  monthsActive     Int       @default(0)
  joinedAt         DateTime  @default(now())
  lastTierUp       DateTime?
  // Ad credits
  adCreditsBalance Int       @default(0)
  adCreditsUsed    Int       @default(0)
  // Timestamps
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  pointsHistory  ClubPoint[]
  rewards        ClubReward[]
  advertisements ClubAdvertisement[]

  @@index([tierId])
}

model ClubPoint {
  id           String         @id @default(cuid())
  membershipId String
  membership   ClubMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  // Point details
  points       Int // positive = earned, negative = spent
  reason       String // purchase | referral | review | social_share | signup_bonus | reward_redemption
  description  String
  // Linked entity
  entityType   String? // invoice | lead | campaign | referral
  entityId     String?
  // Timestamp
  createdAt    DateTime       @default(now())

  @@index([membershipId])
  @@index([reason])
}

model ClubReward {
  id            String   @id @default(cuid())
  name          String
  description   String
  // Cost
  pointsCost    Int // points required to redeem
  // Reward type
  type          String // discount | ad_credits | api_credits | free_month | custom
  value         Float // discount percentage, ad credits count, etc.
  // Availability
  minTierLevel  Int      @default(1) // minimum tier level required
  isActive      Boolean  @default(true)
  stock         Int? // null = unlimited
  // Stats
  redeemedCount Int      @default(0)
  // Visual
  icon          String   @default("🎁")
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships ClubMembership[] // many-to-many through a join (simplified)
}

model ClubAdvertisement {
  id           String         @id @default(cuid())
  membershipId String
  membership   ClubMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Ad content
  title        String
  description  String
  imageUrl     String?
  targetUrl    String // link to the business
  // Placement
  placement    String         @default("dashboard_sidebar") // dashboard_sidebar | landing_page | blog_sidebar | email_footer
  // Scheduling
  startDate    DateTime       @default(now())
  endDate      DateTime?
  // Status
  status       String         @default("pending") // pending | approved | active | rejected | expired
  reviewedAt   DateTime?
  reviewedBy   String?
  // Stats
  impressions  Int            @default(0)
  clicks       Int            @default(0)
  // Cost
  creditsUsed  Int            @default(1) // ad credits consumed
  // Timestamps
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([placement])
}

// ============================================================================
// Ecommerce Platform Analyzer (Amazon, AliExpress, Alibaba, eBay, etc.)
// ============================================================================

model EcommerceProduct {
  id               String    @id @default(cuid())
  // Product identification
  asin             String? // Amazon ASIN
  productId        String? // Platform product ID
  platform         String // amazon | aliexpress | alibaba | ebay | shopify | etsy
  title            String
  imageUrl         String?
  productUrl       String?
  // Pricing
  price            Float
  currency         String    @default("USD")
  originalPrice    Float? // before discount
  costEstimate     Float? // estimated sourcing cost
  // Metrics
  rating           Float?
  reviewCount      Int?
  salesPerMonth    Int? // estimated monthly sales
  revenuePerMonth  Float? // estimated monthly revenue
  bsrRank          Int? // Best Sellers Rank (Amazon)
  // FBA / Fees
  fbaFee           Float?
  referralFee      Float? // platform referral fee
  totalFees        Float?
  estimatedProfit  Float? // per unit
  estimatedMargin  Float? // percentage
  estimatedROI     Float? // percentage
  // Competition
  competitionLevel String? // low | medium | high | very_high
  sellerCount      Int?
  // Trends
  trendDirection   String? // rising | stable | declining
  trendScore       Int? // 0-100
  // Metadata
  category         String?
  brand            String?
  keywords         String? // JSON array
  // Analysis
  aiAnalysis       String? // JSON: { opportunity, risks, recommendations }
  lastChecked      DateTime?
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([platform])
  @@index([tenantId])
  @@index([competitionLevel])
}

model ResellerOpportunity {
  id                String   @id @default(cuid())
  title             String
  description       String
  // Type
  type              String // amazon_fba | aliexpress_dropship | alibaba_wholesale | ebay_resell | affiliate | white_label | private_label
  category          String // electronics | home | beauty | toys | fashion | sports | auto | general
  platform          String // amazon | aliexpress | alibaba | ebay | shopify | etsy | walmart
  // Investment
  initialInvestment Float // USD required to start
  monthlyCostMin    Float // minimum monthly operating cost
  monthlyCostMax    Float // maximum monthly operating cost
  // Revenue estimates
  monthlyRevenueMin Float
  monthlyRevenueMax Float
  monthlyProfitMin  Float
  monthlyProfitMax  Float
  // Timeline
  setupTimeDays     Int // days to set up
  timeToProfitDays  Int // days until first profit
  breakEvenMonths   Int // months to recover initial investment
  // Risk
  riskLevel         String // low | medium | high | very_high
  riskScore         Int // 0-100 (higher = riskier)
  riskFactors       String? // JSON array
  // Requirements
  requirements      String? // JSON array: ["Business license", "Bank account", ...]
  skills            String? // JSON array: ["SEO", "Customer service", ...]
  region            String? // global | us | eu | asia | middle_east
  // Benefits
  benefits          String? // JSON array
  pros              String? // JSON array
  cons              String? // JSON array
  // Status
  isActive          Boolean  @default(true)
  isFeatured        Boolean  @default(false)
  // Stats
  viewCount         Int      @default(0)
  applicationCount  Int      @default(0)
  // Visual
  icon              String   @default("📦")
  color             String   @default("#0A2A3A")
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  applications ResellerApplication[]

  @@index([type])
  @@index([platform])
  @@index([riskLevel])
  @@index([isActive])
}

model ResellerApplication {
  id                String              @id @default(cuid())
  opportunityId     String
  opportunity       ResellerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Application data
  applicantName     String
  applicantEmail    String
  applicantPhone    String?
  businessName      String?
  // Investment plan
  plannedInvestment Float?
  plannedTimeline   String? // e.g. "3 months"
  experience        String? // beginner | intermediate | experienced
  // Status
  status            String              @default("pending") // pending | approved | rejected | active | suspended
  reviewedAt        DateTime?
  reviewedBy        String?
  reviewNotes       String?
  // Contract
  contractStart     DateTime?
  contractEnd       DateTime?
  agreedTerms       Boolean             @default(false)
  // Revenue tracking (after approval)
  totalRevenue      Float               @default(0)
  totalCommission   Float               @default(0)
  // Timestamps
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([tenantId])
  @@index([opportunityId])
  @@index([status])
}

model ProfitEstimate {
  id              String   @id @default(cuid())
  // Inputs
  productPrice    Float // selling price
  productCost     Float // sourcing cost
  platform        String // amazon | aliexpress | alibaba | ebay
  monthlyVolume   Int // units per month
  // Calculated
  platformFee     Float // referral fee
  fbaFee          Float // fulfillment fee
  shippingCost    Float
  advertisingCost Float // PPC / ads per month
  otherCosts      Float
  // Results
  profitPerUnit   Float
  monthlyProfit   Float
  monthlyRevenue  Float
  margin          Float // percentage
  roi             Float // percentage
  breakEvenUnits  Int // units to recover initial investment
  breakEvenMonths Float
  // Metadata
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([tenantId])
}

// ============================================================================
// Attribution Tracking (Metrix competitor — source tracking)
// ============================================================================

model AttributionEvent {
  id               String    @id @default(cuid())
  userId           String?
  deviceId         String?
  source           String // google_ads | facebook_ads | organic | referral | direct | email
  medium           String?
  campaign         String?
  adGroup          String?
  keyword          String?
  clickId          String?
  clickTimestamp   DateTime?
  installTimestamp DateTime?
  eventName        String    @default("install")
  eventValue       Float?
  isFraud          Boolean   @default(false)
  fraudReason      String?
  ipAddress        String?
  userAgent        String?
  country          String?
  city             String?
  revenue          Float?
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())

  @@index([tenantId])
  @@index([source])
  @@index([isFraud])
}

model FraudRule {
  id            String   @id @default(cuid())
  name          String
  type          String // click_injection | sdk_spoofing | click_spamming | ip_anomaly | device_farm
  description   String
  config        String // JSON
  severity      String   @default("medium")
  action        String   @default("flag")
  isActive      Boolean  @default(true)
  totalDetected Int      @default(0)
  totalBlocked  Int      @default(0)
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model Cohort {
  id            String   @id @default(cuid())
  name          String
  cohortDate    DateTime
  cohortSize    Int      @default(0)
  retentionData String?
  revenueData   String?
  segment       String?
  segmentValue  String?
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([tenantId])
}

model MarketingFunnel {
  id          String   @id @default(cuid())
  name        String
  description String?
  stages      String // JSON
  results     String? // JSON
  startDate   DateTime
  endDate     DateTime
  segment     String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model CustomerJourney {
  id             String   @id @default(cuid())
  name           String
  description    String?
  steps          String // JSON
  trigger        String // signup | purchase | abandonment | custom_event | scheduled
  triggerConfig  String?
  isActive       Boolean  @default(true)
  totalEnrolled  Int      @default(0)
  totalCompleted Int      @default(0)
  totalConverted Int      @default(0)
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

model PushNotification {
  id             String    @id @default(cuid())
  title          String
  body           String
  iconUrl        String?
  imageUrl       String?
  actionUrl      String?
  segment        String?
  scheduledAt    DateTime?
  sentAt         DateTime?
  sentCount      Int       @default(0)
  deliveredCount Int       @default(0)
  clickedCount   Int       @default(0)
  status         String    @default("draft")
  platform       String    @default("both")
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

