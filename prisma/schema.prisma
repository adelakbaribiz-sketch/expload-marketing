// ============================================================================
// Wholesale Distribution System (Master Distributor Model)
// ============================================================================

model Distributor {
  id                     String    @id @default(cuid())
  // Linked tenant (distributor's own tenant on platform)
  tenantId               String    @unique
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Business info
  companyName            String
  legalName              String?
  taxId                  String?
  registrationNumber     String?
  country                String
  region                 String?
  city                   String?
  address                String?
  postalCode             String?
  // Contact
  contactName            String
  contactEmail           String
  contactPhone           String?
  // Banking
  bankName               String?
  bankAccount            String?
  iban                   String?
  swiftCode              String?
  // Distributor tier
  tier                   String    @default("standard") // standard | silver | gold | platinum | master
  // Contract reference
  contractId             String?   @unique
  // Sales performance
  totalLicensesPurchased Int       @default(0)
  totalLicensesAllocated Int       @default(0)
  totalLicensesUsed      Int       @default(0)
  totalRevenue           Float     @default(0)
  totalPaidToPlatform    Float     @default(0)
  totalCommissionEarned  Float     @default(0)
  // Status
  status                 String    @default("pending") // pending | active | suspended | terminated
  approvedAt             DateTime?
  approvedBy             String?
  suspendedAt            DateTime?
  terminatedAt           DateTime?
  // Metadata
  notes                  String?
  internalOwnerId        String? // assigned InternalEmployee ID (partner manager)
  // Timestamps
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  contracts       DistributorContract[]
  licensePackages LicensePackage[]
  allocations     LicenseAllocation[]
  territories     TerritoryExclusivity[]
  payouts         DistributorPayout[]
  supportTickets  DistributorSupportTicket[]
  auditAccess     DistributorAuditLog[]

  @@index([status])
  @@index([tier])
  @@index([country])
}

model DistributorContract {
  id                       String      @id @default(cuid())
  distributorId            String
  distributor              Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  // Contract details
  contractNumber           String      @unique
  type                     String // master_distributor | regional | exclusive | non_exclusive
  startDate                DateTime
  endDate                  DateTime?
  // Financial commitments
  minimumGuarantee         Float       @default(0) // annual minimum sales commitment
  minimumGuaranteePeriod   String      @default("annual") // quarterly | semi_annual | annual
  wholesaleDiscountPercent Float       @default(40) // discount off retail for distributor
  revSharePercent          Float       @default(0) // optional revenue share on top
  // Payment terms
  paymentTerms             String      @default("prepaid") // prepaid | net_15 | net_30 | net_60
  currency                 String      @default("USD")
  // Territory
  territoryScope           String? // JSON: { countries: [], regions: [] }
  isExclusive              Boolean     @default(false)
  // Legal
  signedByDistributor      String?
  signedByPlatform         String?
  signedAtDistributor      DateTime?
  signedAtPlatform         DateTime?
  documentUrl              String?
  // Status
  status                   String      @default("draft") // draft | pending_signature | active | expired | terminated
  // Auto-renewal
  autoRenew                Boolean     @default(false)
  renewalTermMonths        Int         @default(12)
  // Timestamps
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@index([distributorId])
  @@index([status])
}

model LicensePackage {
  id                    String       @id @default(cuid())
  // SKU definition (wholesale bundle)
  sku                   String       @unique
  name                  String
  description           String?
  // Bundle size
  licenseCount          Int // e.g. 100, 500, 1000
  // Pricing
  wholesalePrice        Float // what distributor pays
  retailPriceSuggestion Float // suggested end-user price
  currency              String       @default("USD")
  // Package features
  planTier              String       @default("pro") // free | pro | enterprise
  validityMonths        Int          @default(12) // license validity per seat
  features              String? // JSON: included features
  // Targeting
  tierRestriction       String? // standard | silver | gold | platinum | master (null = any)
  // Status
  isActive              Boolean      @default(true)
  // Stats
  totalSold             Int          @default(0)
  totalRevenue          Float        @default(0)
  // Ownership
  distributorId         String? // null = platform-defined package; non-null = distributor-custom
  distributor           Distributor? @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  // Timestamps
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  allocations LicenseAllocation[]

  @@index([distributorId])
  @@index([isActive])
  @@index([tierRestriction])
}

model LicenseAllocation {
  id               String         @id @default(cuid())
  // License pool source
  distributorId    String
  distributor      Distributor    @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  packageId        String
  package          LicensePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  // Allocated seat
  licenseKey       String         @unique
  // End-customer (allocated by distributor)
  customerEmail    String?
  customerName     String?
  customerTenantId String? // if customer activated on platform
  // Status
  status           String         @default("in_pool") // in_pool | allocated | activated | suspended | expired | revoked
  // Validity
  issuedAt         DateTime?
  activatedAt      DateTime?
  expiresAt        DateTime?
  revokedAt        DateTime?
  revokeReason     String?
  // Pricing (locked at allocation)
  salePrice        Float? // what distributor sold it for
  saleCurrency     String         @default("USD")
  // Metadata
  notes            String?
  // Timestamps
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([distributorId])
  @@index([packageId])
  @@index([status])
  @@index([customerEmail])
}

model TerritoryExclusivity {
  id                     String      @id @default(cuid())
  distributorId          String
  distributor            Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  // Territory scope
  country                String // ISO 3166-1 alpha-2
  region                 String? // state/province
  city                   String?
  // Exclusivity
  isExclusive            Boolean     @default(true)
  exclusivityLevel       String      @default("country") // city | region | country
  // Conditions
  minimumSalesCommitment Float       @default(0)
  commitmentPeriod       String      @default("annual")
  // Performance tracking
  achievedSales          Float       @default(0)
  lastReviewedAt         DateTime?
  // Status
  status                 String      @default("active") // active | under_review | revoked | expired
  startDate              DateTime    @default(now())
  endDate                DateTime?
  // Timestamps
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@unique([distributorId, country, region, city])
  @@index([distributorId])
  @@index([country])
  @@index([status])
}

model DistributorPayout {
  id               String      @id @default(cuid())
  distributorId    String
  distributor      Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  // Payout period
  periodStart      DateTime
  periodEnd        DateTime
  // Financials
  grossSales       Float
  platformShare    Float // platform's cut
  distributorShare Float // distributor's payout
  currency         String      @default("USD")
  // Settlement
  method           String // bank_transfer | paypal | crypto | wire | credit_balance
  reference        String?
  paidAt           DateTime?
  // Status
  status           String      @default("pending") // pending | approved | paid | disputed | void
  approvedBy       String?
  approvedAt       DateTime?
  // Metadata
  notes            String?
  lineItems        String? // JSON: breakdown of commissions
  // Timestamps
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([distributorId])
  @@index([status])
}

model DistributorSupportTicket {
  id                     String      @id @default(cuid())
  distributorId          String
  distributor            Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  // Ticket
  ticketNumber           String      @unique
  subject                String
  description            String
  category               String // technical_bug | billing | license_issue | account_access | feature_request | other
  priority               String      @default("normal") // low | normal | high | urgent | critical
  // Tier routing — distributors handle Tier 1 & 2; platform only handles Tier 3 (real bugs)
  tier                   String      @default("tier3") // tier1 | tier2 | tier3
  escalatedByDistributor Boolean     @default(false)
  // Resolution
  status                 String      @default("open") // open | in_progress | escalated | resolved | closed | reopened
  resolution             String?
  resolvedAt             DateTime?
  resolvedBy             String?
  // Internal assignment
  assignedToId           String? // InternalEmployee ID
  // Metadata
  attachments            String? // JSON array
  // Timestamps
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([distributorId])
  @@index([status])
  @@index([tier])
  @@index([priority])
}

model DistributorAuditLog {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  // Action
  action        String // license_issued | license_revoked | customer_added | payout_requested | contract_signed | ...
  entityType    String
  entityId      String?
  description   String
  changes       String? // JSON diff
  // Actor
  actorType     String // distributor_user | platform_admin | internal_employee | system
  actorId       String?
  actorName     String?
  ipAddress     String?
  userAgent     String?
  // Timestamp
  createdAt     DateTime    @default(now())

  @@index([distributorId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================================
// Crypto Payments (Multi-chain: BTC, ETH, USDT, USDC, TRX)
// ============================================================================

model CryptoPayment {
  id                    String    @id @default(cuid())
  tenantId              String?
  tenant                Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  distributorId         String? // optional: distributor-level crypto payment
  // Payment details
  amount                Float // fiat amount
  fiatCurrency          String    @default("USD")
  cryptoAmount          Float? // calculated crypto amount
  cryptoCurrency        String // BTC | ETH | USDT | USDC | TRX | BNB | SOL
  chain                 String // bitcoin | ethereum | tron | bsc | solana | polygon
  // Gateway
  gateway               String    @default("nowpayments") // nowpayments | coinpayments | coinbase_commerce | bitpay | manual
  gatewayPaymentId      String?   @unique
  gatewayInvoiceUrl     String?
  // Wallet
  payToAddress          String? // generated deposit address
  refundAddress         String?
  // Status
  status                String    @default("pending") // pending | confirming | confirmed | completed | failed | expired | refunded
  confirmations         Int       @default(0)
  requiredConfirmations Int       @default(3)
  // Linked invoice/payment
  invoiceId             String?
  paymentId             String? // links to Payment record when completed
  // Deliberately SetNull, not Cascade, matching this model's own
  // tenant relation above: CryptoPayment is a financial/audit record this
  // app keeps even after the Payment it produced (or the tenant that made
  // it) is gone — it should never be silently destroyed, only lose its
  // now-dangling pointer. Found via a Phase 18 regression test:
  // Payment.tenant cascades on tenant deletion, but this field was a bare
  // string with no relation at all, so a completed CryptoPayment survived
  // tenant deletion (correctly) while pointing at a paymentId that no
  // longer existed (a real dangling reference, caught by
  // scripts/db-integrity-check.ts). See QA-AUDIT.md.
  payment               Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  // Timestamps
  initiatedAt           DateTime  @default(now())
  detectedAt            DateTime? // when first confirmation seen
  completedAt           DateTime?
  expiredAt             DateTime?
  // Metadata
  exchangeRate          Float?
  feeAmount             Float?
  netAmount             Float?
  rawPayload            String? // raw webhook payload
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([tenantId])
  @@index([distributorId])
  @@index([status])
  @@index([cryptoCurrency])
  @@index([createdAt])
  @@index([tenantId, status])
}

model CryptoWallet {
  id               String    @id @default(cuid())
  // Owner
  tenantId         String?
  tenant           Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  // Wallet info
  label            String // user-friendly label
  currency         String // BTC | ETH | USDT | USDC | TRX
  chain            String
  address          String    @unique
  // Gateway-managed (we don't store private keys)
  isPlatformWallet Boolean   @default(false) // platform treasury wallet
  // Status
  isActive         Boolean   @default(true)
  // Verification
  verifiedAt       DateTime?
  // Metadata
  balance          Float     @default(0)
  lastSyncedAt     DateTime?
  // Timestamps
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId])
  @@index([currency])
  @@index([isPlatformWallet])
}

// ============================================================================
// International Payment Gateways (beyond Stripe)
// ============================================================================

model PaymentGatewayConfig {
  id                  String   @id @default(cuid())
  provider            String   @unique // stripe | paypal | razorpay | moyasar | paystack | flutterwave | nowpayments | coinpayments | coinbase_commerce | bitpay | mollie | midtrans | iyzico | tap | hyperpay
  displayName         String
  // Credentials (encrypted at rest via app layer)
  apiKey              String? // encrypted
  secretKey           String? // encrypted
  webhookSecret       String? // encrypted
  merchantId          String?
  // Supported features
  supportedCurrencies String? // JSON: ["USD","EUR","SAR","AED",...]
  supportedMethods    String? // JSON: ["card","bank_transfer","crypto","apple_pay","google_pay"]
  supportedCountries  String? // JSON: ["US","SA","AE","IN","NG",...]
  // Status
  isActive            Boolean  @default(false)
  isSandbox           Boolean  @default(true)
  priority            Int      @default(100) // lower = preferred
  // Routing
  routeBy             String   @default("currency") // currency | country | amount | method
  routeRules          String? // JSON
  // Metadata
