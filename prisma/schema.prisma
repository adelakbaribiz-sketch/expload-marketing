model CofounderProfile {
  id             String    @id @default(cuid())
  // Person info
  name           String
  email          String?
  linkedin       String?
  avatar         String?
  bio            String?
  // Professional
  currentRole    String?
  currentCompany String?
  experience     Int? // years
  skills         String? // JSON: ["Engineering","Sales","Marketing","Product","Design"]
  industries     String? // JSON: ["SaaS","AI","Fintech"]
  // Co-founder preferences
  lookingFor     String? // JSON: what role they want as co-founder
  commitment     String    @default("full-time") // full-time | part-time | advisor
  equityExpected Float? // percentage
  availableFrom  DateTime?
  relocationOk   Boolean   @default(false)
  remoteOk       Boolean   @default(true)
  // Matching
  matchScore     Int?
  matchReasons   String?
  // Status
  isVerified     Boolean   @default(false)
  isActive       Boolean   @default(true)
  contactStatus  String    @default("not_contacted")
  lastContactAt  DateTime?
  // Ownership
  tenantId       String?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

