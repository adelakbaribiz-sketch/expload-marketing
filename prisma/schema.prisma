// ============================================================================
// Internal Employees & Departments (Platform-side staff)
// ============================================================================

model InternalDepartment {
  id             String               @id @default(cuid())
  name           String               @unique
  displayName    String
  description    String?
  // Parent (for sub-departments)
  parentId       String?
  parent         InternalDepartment?  @relation("DeptHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       InternalDepartment[] @relation("DeptHierarchy")
  // Department head
  headEmployeeId String?
  // Permissions scope
  accessScope    String               @default("limited") // limited | full_platform | distributors_only | finance_only | support_only | engineering_only
  // Status
  isActive       Boolean              @default(true)
  // Metadata
  budget         Float?
  costCenter     String?
  // Timestamps
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  employees InternalEmployee[]

  @@index([parentId])
  @@index([isActive])
}

model InternalEmployee {
  id                         String                     @id @default(cuid())
  // Link to User account
  userId                     String                     @unique
  user                       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Department
  departmentId               String?
  department                 InternalDepartment?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  // Role & permissions
  employeeRole               String                     @default("staff") // staff | senior | lead | manager | director | vp | c_level
  platformRole               String                     @default("employee") // employee | admin | super_admin
  permissions                String                     @default("[]") // JSON array of permission strings
  // Job info
  jobTitle                   String?
  employeeId                 String?                    @unique // HR ID
  employmentType             String                     @default("full_time") // full_time | part_time | contractor | intern
  startDate                  DateTime                   @default(now())
  endDate                    DateTime?
  // Manager
  managerId                  String?
  manager                    InternalEmployee?          @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports              InternalEmployee[]         @relation("EmployeeManager")
  // Responsibility area
  assignedDistributorIds     String? // JSON: [distributorId, ...] — for partner managers
  assignedRegion             String? // for regional managers
  // Status
  status                     String                     @default("active") // active | on_leave | suspended | terminated
  // Compensation (HR-private, restricted)
  salary                     Float?
  salaryCurrency             String                     @default("USD")
  bonusEligible              Boolean                    @default(false)
  // Contact
  workPhone                  String?
  workEmail                  String?
  location                   String?
  avatar                     String?
  // Audit
  lastLoginAt                DateTime?
  lastActiveAt               DateTime?
  // Timestamps
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  internalEmployeeActivities InternalEmployeeActivity[]
  virtualAssistant           VirtualAssistant?

  @@index([departmentId])
  @@index([employeeRole])
  @@index([platformRole])
  @@index([status])
}

model InternalEmployeeActivity {
  id          String           @id @default(cuid())
  employeeId  String
  employee    InternalEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  action      String // login | distributor_assigned | ticket_resolved | payout_approved | contract_signed | ...
  entityType  String
  entityId    String?
  description String
  metadata    String? // JSON
  ipAddress   String?
  userAgent   String?
  // Timestamp
  createdAt   DateTime         @default(now())

  @@index([employeeId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================================
// Financial Reports (Platform-level & Distributor-level)
// ============================================================================

model FinancialReport {
  id                    String   @id @default(cuid())
  // Scope
  scope                 String // platform | distributor | tenant | department
  scopeId               String? // distributorId / tenantId / departmentId (null for platform)
  // Report period
  periodType            String // daily | weekly | monthly | quarterly | annual | custom
  periodStart           DateTime
  periodEnd             DateTime
  // Report type
  type                  String // revenue_summary | commission_summary | payout_summary | license_usage | territory_performance | gateway_breakdown | crypto_settlement | tax_summary | churn_analysis
  // Aggregated metrics (JSON)
  metrics               String // JSON: { totalRevenue, netRevenue, refunds, fees, ... }
  breakdown             String? // JSON: per-gateway / per-currency / per-territory
  // Generated by
  generatedById         String? // InternalEmployee ID or system
  generatedByName       String?
  generationMethod      String   @default("auto") // auto | manual | scheduled
  // Distribution
  sharedWithDistributor Boolean  @default(false)
  // Status
  status                String   @default("generated") // generated | reviewed | approved | published | archived
  // File
  fileUrl               String?
  fileFormat            String   @default("pdf") // pdf | xlsx | csv | json
  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant?  @relation(fields: [tenantId], references: [id])
  tenantId              String?

  @@index([scope, scopeId])
  @@index([periodType])
  @@index([type])
  @@index([status])
}

// ============================================================================
// Multi-LLM Aggregator & Negotiation System
// ============================================================================

model LlmProviderConfig {
  id                String    @id @default(cuid())
  provider          String    @unique // openrouter | groq | cerebras | mistral | huggingface | zai
  displayName       String
  // Credentials (encrypted at app layer)
  apiKey            String? // encrypted
  apiBaseUrl        String
  // Models
  models            String? // JSON: [{ id, name, contextWindow, isFree }]
  // Free-tier management
  isFreeTier        Boolean   @default(true)
  dailyTokenLimit   Int       @default(1000000)
  monthlyTokenLimit Int       @default(10000000)
  // Rate limit handling
  requestsPerMinute Int       @default(60)
  // Status
  isActive          Boolean   @default(true)
  priority          Int       @default(100) // lower = preferred
  // Fallback config
  cooldownMinutes   Int       @default(5) // how long to skip after rate-limit
  lastFailedAt      DateTime?
  failureCount      Int       @default(0)
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  usageRecords LlmUsageRecord[]
  auditEvents  LlmAuditEvent[]

  @@index([isActive])
  @@index([priority])
}

model LlmUsageRecord {
  id                  String             @id @default(cuid())
  providerConfigId    String
  provider            String
  // Usage details
  model               String
  inputTokens         Int                @default(0)
  outputTokens        Int                @default(0)
  totalTokens         Int                @default(0)
  // Cost (0 for free tier)
  costUsd             Float              @default(0)
  // Context
  requestType         String // chat | completion | embedding | negotiation | extraction | onboarding
  tenantId            String?
  sessionType         String? // negotiation | onboarding
  sessionId           String?
  // Status
  status              String             @default("success") // success | rate_limited | error | timeout
  errorMessage        String?
  latencyMs           Int?
  // Timestamp
  createdAt           DateTime           @default(now())
  tenant              Tenant?            @relation(fields: [tenantId], references: [id])
  llmProviderConfig   LlmProviderConfig? @relation(fields: [llmProviderConfigId], references: [id])
  llmProviderConfigId String?

  @@index([providerConfigId])
  @@index([provider])
  @@index([createdAt])
  @@index([tenantId])
}

model LlmAuditEvent {
  id                  String             @id @default(cuid())
  providerConfigId    String
  provider            String
  eventType           String // provider_switched | rate_limited | quota_warning | quota_exceeded | recovered | fallback_triggered
  message             String
  fromProvider        String?
  toProvider          String?
  metadata            String? // JSON
  createdAt           DateTime           @default(now())
  llmProviderConfig   LlmProviderConfig? @relation(fields: [llmProviderConfigId], references: [id])
  llmProviderConfigId String?

  @@index([providerConfigId])
  @@index([eventType])
  @@index([createdAt])
}

// ============================================================================
// Onboarding & Data Ingestion
// ============================================================================

model OnboardingSession {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Customer info
  customerName       String?
  customerEmail      String?
  customerPhone      String?
  businessName       String?
  businessWebsite    String?
  industry           String?
  // Wizard state
  currentStep        Int      @default(1)
  totalSteps         Int      @default(6)
  status             String   @default("in_progress") // in_progress | completed | abandoned | escalated_to_negotiation
  // Structured answers (JSON: [{ step, question, answer }])
  answers            String? // JSON
  // Custom system prompt
  customSystemPrompt String?
  // Extracted context (combined: answers + crawled site + uploaded docs)
  extractedContext   String? // long text
  // Crawl status
  crawlStatus        String   @default("pending") // pending | in_progress | completed | failed
  crawlError         String?
  // Document processing
  docsProcessed      Int      @default(0)
  // AI-generated summary
  aiSummary          String?
  aiNeedsAnalysis    String? // JSON: { budget, timeline, scope, priorities }
  // Negotiation link
  negotiationId      String?  @unique
  // Timestamps
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  documents OnboardingDocument[]

  @@index([tenantId])
  @@index([status])
}

model OnboardingDocument {
  id            String            @id @default(cuid())
  sessionId     String
  session       OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // File info
  filename      String
  fileType      String // pdf | docx | txt | md | html
  fileSize      Int
  // Storage
  storageUrl    String // local path or S3 URL
  // Processing
  status        String            @default("pending") // pending | processing | completed | failed
  extractedText String?
  textLength    Int               @default(0)
  errorMessage  String?
  // Metadata
  uploadedAt    DateTime          @default(now())
  processedAt   DateTime?

  @@index([sessionId])
  @@index([status])
}

// ============================================================================
// Negotiation Engine (State Pattern)
// ============================================================================

model NegotiationSession {
  id                     String   @id @default(cuid())
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  onboardingId           String?
  // Customer
  customerName           String
  customerEmail          String?
  // Project
  projectName            String
  projectDescription     String
  // State machine
  currentState           String   @default("initial") // initial | mvp | economic | phased | rejected_all | accepted | closed
  proposalRound          Int      @default(0) // 0 = initial, 1 = MVP, 2 = Economic, 3 = Phased
  // Context (used by LLM)
  contextSummary         String // combined from onboarding
  systemPrompt           String?
  // Customer constraints
  customerBudget         Float?
  customerBudgetCurrency String   @default("USD")
  customerTimeline       String?
  customerPriorities     String? // JSON
  // Final outcome
  acceptedProposalId     String?
  rejectionReasons       String? // JSON: [{ round, reason }]
  // Status
  status                 String   @default("active") // active | accepted | rejected_all | abandoned
  // Timestamps
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  proposals   NegotiationProposal[]
  auditEvents NegotiationAuditEvent[]

  @@index([tenantId])
  @@index([status])
  @@index([currentState])
}

model NegotiationProposal {
  id                       String             @id @default(cuid())
  sessionId                String
  session                  NegotiationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Round info
  round                    Int // 0 = initial, 1 = MVP, 2 = Economic, 3 = Phased
  type                     String // initial | mvp | economic | phased
  // Proposal content
  title                    String
  description              String // long-form
  features                 String? // JSON: included features list
  excludedFeatures         String? // JSON: what was cut from initial
  // Timeline & scope
  deliveryWeeks            Int
  deliveryMilestone        String? // for phased
  // Pricing
  price                    Float
  currency                 String             @default("USD")
  paymentSchedule          String? // e.g. "50% upfront, 50% on delivery" or "3 phase payments"
  // Comparison
  savingsPercent           Float              @default(0) // vs initial
  deliveryReductionPercent Float              @default(0)
  scopeReductionPercent    Float              @default(0)
  // AI generation metadata
  llmProvider              String?
  inputTokens              Int                @default(0)
  outputTokens             Int                @default(0)
  rationale                String? // 1-2 sentence LLM explanation of why this offer makes sense at this round
  // Customer response
  customerResponse         String? // accepted | rejected | pending
  customerFeedback         String?
  respondedAt              DateTime?
  // Timestamps
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([sessionId])
  @@index([type])
  @@index([customerResponse])
}

model NegotiationAuditEvent {
  id        String             @id @default(cuid())
  sessionId String
  session   NegotiationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType String // proposal_generated | proposal_accepted | proposal_rejected | state_changed | llm_provider_switched | error
  fromState String?
  toState   String?
  round     Int?
  message   String
  metadata  String? // JSON
  createdAt DateTime           @default(now())

  @@index([sessionId])
  @@index([eventType])
}

// ============================================================================
// Virtual Assistant Service (paid staff who do customer projects)
// ============================================================================

model VirtualAssistant {
  id                    String            @id @default(cuid())
  // Link to InternalEmployee if assistant is in-house
  employeeId            String?           @unique
  employee              InternalEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  // Identity
  name                  String
  email                 String            @unique
  phone                 String?
  avatar                String?
  bio                   String?
  // Skills & specialization
  skills                String // JSON: ["SEO","Content","Ads","Design","Development","Social"]
  primarySkill          String // main specialization
  languages             String? // JSON: ["en","fa","ar"]
  // Work mode
  workMode              String            @default("remote") // remote | in_office | hybrid
  location              String?
  timezone              String            @default("UTC")
  // Pricing
  hourlyRate            Float             @default(25) // USD per hour
  monthlyRate           Float? // USD per month (for retainer)
  currency              String            @default("USD")
  // Performance
  rating                Float             @default(5.0) // 0-5
  totalProjects         Int               @default(0)
  totalHours            Float             @default(0)
  totalEarnings         Float             @default(0)
  completionRate        Float             @default(100) // % of projects completed on time
  // Availability
  isAvailable           Boolean           @default(true)
  maxConcurrentProjects Int               @default(3)
  // Verification
  isVerified            Boolean           @default(false)
  verifiedAt            DateTime?
  // Status
  status                String            @default("active") // active | suspended | terminated
  // Timestamps
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  assignments  AssistantAssignment[]
  timesheets   AssistantTimesheet[]
  performances AssistantPerformance[]

  @@index([primarySkill])
  @@index([status])
  @@index([isAvailable])
}

model AssistantService {
  id             String   @id @default(cuid())
  // Service catalog
  name           String
  description    String
  category       String // seo | content | ads | social | design | development | email | full_marketing | other
  // Deliverables
  deliverables   String? // JSON: ["10 blog posts","5 social graphics",...]
  // Pricing
  pricingType    String // hourly | fixed | monthly_retainer
  fixedPrice     Float?
  hourlyEstimate Float? // estimated hours
  monthlyHours   Int? // for retainer
  currency       String   @default("USD")
  // Timeline
  estimatedDays  Int // delivery time
  // Requirements
  requiredSkills String? // JSON: skill IDs
  // Status
  isActive       Boolean  @default(true)
  // Stats
  totalAssigned  Int      @default(0)
  totalRevenue   Float    @default(0)
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments AssistantAssignment[]

  @@index([category])
  @@index([isActive])
}

model AssistantAssignment {
  id                 String            @id @default(cuid())
  // Relations
  assistantId        String
  assistant          VirtualAssistant  @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  serviceId          String?
  service            AssistantService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  // Customer
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Project details
  projectName        String
  projectDescription String
  // Pricing
  pricingType        String // hourly | fixed | monthly_retainer
  agreedRate         Float // rate at assignment time
  currency           String            @default("USD")
  totalBudget        Float? // for fixed-price
  // Timeline
  startDate          DateTime          @default(now())
  expectedEndDate    DateTime?
  actualEndDate      DateTime?
  // Work tracking
  hoursLogged        Float             @default(0)
  hoursBudget        Float? // max hours (for hourly)
  tasksTotal         Int               @default(0)
  tasksCompleted     Int               @default(0)
  // Deliverables
  deliverables       String? // JSON: [{ name, status, submittedAt, approvedAt }]
  // Status
  status             String            @default("active") // active | paused | completed | cancelled | disputed
  // Customer feedback
  customerRating     Int? // 1-5
  customerFeedback   String?
  // Payout
  totalPaid          Float             @default(0)
  lastPayoutAt       DateTime?
  // Timestamps
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  timesheets   AssistantTimesheet[]
  performances AssistantPerformance[]

  @@index([assistantId])
  @@index([tenantId])
  @@index([status])
}

model AssistantTimesheet {
  id                String               @id @default(cuid())
  assistantId       String
  assistant         VirtualAssistant     @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  assignmentId      String?
  assignment        AssistantAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  // Time entry
  date              DateTime
  hoursWorked       Float
  taskDescription   String
  // Activity detection
  activityType      String // manual | automatic | idle | active | deep_work
  keystrokesCount   Int                  @default(0) // automatic activity detection
  mouseMovements    Int                  @default(0)
  appsUsed          String? // JSON: ["VS Code","Figma","Chrome"]
  screenshots       String? // JSON: [{ url, timestamp }]
  // Productivity
  productivityScore Int                  @default(0) // 0-100, AI-scored
  // Status
  status            String               @default("pending") // pending | approved | rejected
  approvedBy        String?
  approvedAt        DateTime?
  // Payment
  isPaid            Boolean              @default(false)
  paidAt            DateTime?
  // Timestamp
  createdAt         DateTime             @default(now())

  @@index([assistantId])
  @@index([assignmentId])
  @@index([date])
  @@index([status])
}

model AssistantPerformance {
  id                String               @id @default(cuid())
  assistantId       String
  assistant         VirtualAssistant     @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  assignmentId      String?
  assignment        AssistantAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  // Period
  periodStart       DateTime
  periodEnd         DateTime
  // Metrics
  totalHours        Float
  totalTasks        Int
  completedTasks    Int
  onTimeRate        Float // %
  customerRating    Float? // avg
  qualityScore      Float // 0-100, AI-scored
  productivityScore Float // 0-100
  // Calculated earnings
  grossEarnings     Float
  platformFee       Float // platform commission
  netEarnings       Float // what assistant receives
  // Metadata
  notes             String?
  createdAt         DateTime             @default(now())

  @@index([assistantId])
  @@index([periodStart])
}

// ============================================================================
// Payroll & Salary System (50% owner / 50% staff pool)
// ============================================================================

model PayrollConfig {
  id                  String   @id @default(cuid())
  // Revenue split
  ownerSharePercent   Float    @default(50) // 50% to owner
  staffPoolPercent    Float    @default(40) // 40% to staff pool
  reinvestmentPercent Float    @default(10) // 10% reinvest
  // Staff pool distribution weights by role
  roleWeights         String   @default("{}") // JSON: { c_level: 3, vp: 2.5, director: 2, manager: 1.5, lead: 1.2, senior: 1, staff: 0.7 }
  // Bonus pool
  bonusPoolPercent    Float    @default(5) // % of staff pool reserved for bonuses
  // Payout schedule
  payoutFrequency     String   @default("monthly") // weekly | biweekly | monthly
  payoutDay           Int      @default(1) // day of month (1-28)
  // Status
  isActive            Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model PayrollPeriod {
  id                 String    @id @default(cuid())
  // Period
  periodStart        DateTime
  periodEnd          DateTime
  periodLabel        String // "January 2026", "Week 4 2026", etc.
  // Revenue (input)
  totalRevenue       Float     @default(0)
  ownerShare         Float     @default(0)
  staffPool          Float     @default(0)
  reinvestmentAmount Float     @default(0)
  bonusPool          Float     @default(0)
  // Distribution
  distributions      String? // JSON: [{ employeeId, name, share, hours, performance, bonus, total }]
  // Status
  status             String    @default("draft") // draft | calculated | approved | paid | closed
  calculatedAt       DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  paidAt             DateTime?
  // Metadata
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payments SalaryPayment[]

  @@index([status])
  @@index([periodStart])
}

model SalaryPayment {
  id               String        @id @default(cuid())
  periodId         String
  period           PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId       String // InternalEmployee ID
  employeeName     String
  // Salary components
  baseShare        Float         @default(0) // from staff pool (based on role weight × hours)
  bonusAmount      Float         @default(0)
  overtimeAmount   Float         @default(0)
  deductions       Float         @default(0)
  // Total
  grossAmount      Float
  taxAmount        Float         @default(0)
  netAmount        Float
  currency         String        @default("USD")
  // Payment method
  paymentMethod    String // bank_transfer | paypal | crypto | wise | manual
  paymentReference String?
  paidAt           DateTime?
  // Status
  status           String        @default("pending") // pending | paid | failed | reversed
  // Metadata
  payslipUrl       String?
  createdAt        DateTime      @default(now())

  @@index([periodId])
  @@index([employeeId])
  @@index([status])
}

// ============================================================================
// Support Plans (customer-purchased support packages)
// ============================================================================

model SupportPlan {
  id                  String   @id @default(cuid())
  name                String // Basic | Premium | Enterprise
  description         String
  // Pricing
  monthlyPrice        Float
  annualPrice         Float?
  currency            String   @default("USD")
  // Features (JSON)
  features            String // JSON: ["Email support","48h response time",...]
  // SLA
  responseTimeHours   Int // guaranteed first response time
  resolutionTimeHours Int?
  // Channels
  channels            String // JSON: ["email","chat","phone","slack"]
  // Limits
  monthlyTicketsLimit Int?
  monthlyHoursLimit   Int?
  // Status
  isActive            Boolean  @default(true)
  isFeatured          Boolean  @default(false)
  // Stats
  totalSubscribers    Int      @default(0)
  monthlyRevenue      Float    @default(0)
  // Display
  displayOrder        Int      @default(100)
  color               String   @default("#1B3A4B")
  // Timestamps
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions SupportSubscription[]

  @@index([isActive])
}

model SupportSubscription {
  id                   String      @id @default(cuid())
  planId               String
  plan                 SupportPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  tenantId             String
  tenant               Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Billing
  billingCycle         String // monthly | annual
  startDate            DateTime    @default(now())
  endDate              DateTime?
  nextBillingAt        DateTime
  amount               Float
  currency             String      @default("USD")
  // Auto-renew
  autoRenew            Boolean     @default(true)
  // Payment
  paymentMethod        String? // stripe | paypal | crypto | manual
  stripeSubscriptionId String?
  // Status
  status               String      @default("active") // active | past_due | cancelled | expired
  cancelledAt          DateTime?
  // Usage this cycle
  ticketsUsedThisCycle Int         @default(0)
  hoursUsedThisCycle   Float       @default(0)
  // Timestamps
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tickets SupportTicketItem[]

  @@index([tenantId])
  @@index([status])
}

model SupportTicketItem {
  id               String               @id @default(cuid())
  ticketNumber     String               @unique
  subscriptionId   String?
  subscription     SupportSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  tenantId         String
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Ticket
  subject          String
  description      String
  category         String // technical | billing | how_to | bug | feature_request | account | other
  priority         String               @default("normal") // low | normal | high | urgent | critical
  // SLA tracking
  slaResponseDue   DateTime?
  slaResolutionDue DateTime?
  firstRespondedAt DateTime?
  resolvedAt       DateTime?
  // Assignment
  assignedToId     String? // InternalEmployee ID
  // Communication
  messages         String? // JSON: [{ from, message, timestamp }]
  attachments      String? // JSON
  // Status
  status           String               @default("open") // open | in_progress | waiting_customer | resolved | closed | escalated
  resolution       String?
  customerRating   Int? // 1-5
  // Timestamps
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([subscriptionId])
  @@index([tenantId, status])
}

// ============================================================================
// Vector Search Index (Qdrant-style semantic search)
// ============================================================================

model VectorIndex {
  id             String   @id @default(cuid())
  // Source
  sourceType     String // lead | document | content | knowledge_base | customer
  sourceId       String
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Embedding metadata
  embeddingModel String   @default("text-embedding-3-small")
  embeddingDim   Int      @default(1536)
  // Vector stored as JSON array (for SQLite dev; in production use Qdrant/Pgvector)
  vector         String // JSON: [0.1, 0.2, ...]
  // Text chunk
  textChunk      String // the text that was embedded
  chunkIndex     Int      @default(0)
  // Metadata
  metadata       String? // JSON
  // Timestamp
  createdAt      DateTime @default(now())

  @@index([sourceType, sourceId])
  @@index([tenantId])
  @@index([embeddingModel])
}

// ============================================================================
// Project Brief Intake → Roadmap → 3-Tier Pricing → Payment
// ============================================================================

model ProjectBrief {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Customer info
  businessName    String
  industry        String?
  website         String?
  description     String
  targetMarket    String?
  budget          Float?
  currency        String   @default("USD")
  timeline        String? // "ASAP" | "1-3 months" | "3-6 months" | "6+ months"
  goals           String? // JSON: ["increase sales","brand awareness",...]
  // AI-generated
  roadmap         String? // JSON: phases + milestones
  analysisSummary String?
  aiInsights      String? // JSON
  // 3-tier pricing
  pricingTiers    String? // JSON: [{ name, price, features, deliveryWeeks }]
  recommendedTier String? // "essential" | "growth" | "premium"
  // Payment
  paymentStatus   String   @default("pending") // pending | partial | paid
  paymentOption   String? // "full" | "phased"
  amountPaid      Float    @default(0)
  // Link to negotiation if user wants to negotiate
  negotiationId   String?
  // Status
  status          String   @default("draft") // draft | analyzed | priced | payment_pending | active | completed
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

// ============================================================================
// Global Events Calendar (world holidays + trending events)
// ============================================================================

model GlobalEvent {
  id                     String    @id @default(cuid())
  name                   String
  description            String?
  // Date info
  startDate              DateTime
  endDate                DateTime?
  isRecurring            Boolean   @default(false)
  recurrencePattern      String? // "annual" | "monthly" | "weekly"
  // Categorization
  category               String // holiday | cultural | sports | tech | business | religious | seasonal | trending
  subcategory            String? // e.g. "christmas", "ramadan", "black_friday", "world_cup"
  // Geography
  countries              String? // JSON: ["US","GB","DE"] — empty = global
  regions                String? // JSON: ["mena","eu","asia","latam","africa"]
  // Marketing relevance
  marketingRelevance     String? // "high" | "medium" | "low"
  recommendedIndustries  String? // JSON: ["retail","food","travel"]
  suggestedCampaignTypes String? // JSON: ["discount","content","social","email"]
  // Visual
  icon                   String?
  color                  String    @default("#1B3A4B")
  // Status
  isActive               Boolean   @default(true)
  // Timestamps
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([startDate])
  @@index([category])
  @@index([isActive])
}

// ============================================================================
// Smart Campaign Scheduler (date suggestions based on deposit + events)
// ============================================================================

model CampaignScheduleSuggestion {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Project context
  briefId             String?
  campaignName        String
  campaignType        String // email | social | ads | content | multi_channel
  // Budget
  totalBudget         Float
  depositReceived     Float     @default(0)
  currency            String    @default("USD")
  // AI suggestions
  suggestedStartDates String? // JSON: [{ date, reason, confidence, eventRef }]
  suggestedEndDates   String?
  recommendedDuration Int? // days
  // Linked events
  linkedEventIds      String? // JSON: [eventId, ...]
  // Status
  status              String    @default("suggested") // suggested | approved | scheduled | active | completed
  approvedStartDate   DateTime?
  approvedEndDate     DateTime?
  // Timestamps
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
}

// ============================================================================
// Demo / Simulation Sandbox
// ============================================================================

model SandboxSession {
  id               String   @id @default(cuid())
  // Visitor info (no auth required)
  visitorEmail     String?
  visitorName      String?
  visitorIp        String?
  visitorUserAgent String?
  // Demo config
  demoType         String // "marketing_platform" | "negotiation" | "graph_agent" | "full"
  industry         String? // selected industry scenario
  // Limits
  maxActions       Int      @default(20)
  actionsUsed      Int      @default(0)
  expiresAt        DateTime
  // Mock data
  mockTenantId     String?
  // Conversion
  convertedToUser  Boolean  @default(false)
  convertedUserId  String?
  // Status
  status           String   @default("active") // active | expired | converted
  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  actions  SandboxAction[]
  tenant   Tenant?         @relation(fields: [tenantId], references: [id])
  tenantId String?

  @@index([status])
  @@index([expiresAt])
}

model SandboxAction {
  id         String         @id @default(cuid())
  sessionId  String
  session    SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Action
  actionType String // "view_dashboard" | "click_lead" | "run_simulated_campaign" | ...
  module     String // "leads" | "campaigns" | "negotiation" | etc.
  metadata   String? // JSON
  // Timestamp
  createdAt  DateTime       @default(now())

  @@index([sessionId])
}

// ============================================================================
// AI Decision Engine — explainable-decision memory shared by every module
// that asks the LLM aggregator to choose between options (negotiation,
// campaign scheduling, graph planning, ...). Every row is one decision the
// AI made, with its reasoning, confidence, evidence, alternatives it
// considered, and — once known — whether it was actually right.
// ============================================================================

model AiDecision {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // What was being decided
  domain           String // 'negotiation' | 'campaign_scheduling' | 'graph_planning'
  goal             String // plain-language description of the decision being made
  // The decision
  recommendation   String
  reasoning        String
  confidence       Float     @default(0) // 0-100
  evidence         String? // JSON string[]
  alternatives     String? // JSON [{option, whyNotChosen}]
  expectedOutcome  String?
  risks            String? // JSON string[]
  // Full context for audit/replay
  rawContext       String? // JSON — facts given to the LLM
  rawOutput        String? // JSON — full parsed LLM response
  llmProvider      String?
  llmModel         String?
  sessionId        String?
  // What this decision produced (for linking back to the domain record)
  linkedEntityType String? // 'NegotiationProposal' | 'CampaignScheduleSuggestion' | 'GraphPlan'
  linkedEntityId   String?
  // Self-improvement loop
  outcomeRecorded  Boolean   @default(false)
  actualOutcome    String?
  wasAccurate      Boolean?
  outcomeAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([tenantId, domain])
  @@index([tenantId, createdAt])
}
