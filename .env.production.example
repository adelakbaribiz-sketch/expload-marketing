# ============================================================================
# Expload Marketing SaaS — PRODUCTION Environment
# ============================================================================
# Copy to .env.production and fill in every value marked REQUIRED before
# running `docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build`.
#
# This file was referenced by DEPLOY.md long before it actually existed in
# the repo (Phase 19 fixed that) — every value below is consumed directly
# by docker-compose.prod.yml's `environment:` blocks; nothing here is
# read by the app process itself except through that file.
#
# Difference from .env.example (local dev): SQLite → PostgreSQL, no
# secrets left at placeholder defaults (docker-compose.prod.yml hard-fails
# startup on several of these if unset — see the `:?` guards there), and
# every optional integration is genuinely optional here too (blank = that
# feature fails soft, per its own module's documented fallback — never
# fabricates success).
# ============================================================================

# --- Named environment label ---
# Distinct from NODE_ENV (which Next.js always sets to "production" for
# any production-mode build, staging included) — this is what tags every
# structured log line and lets you tell a staging alert from a real one.
DEPLOY_ENV=production

# --- REQUIRED: Domain & TLS ---
# Your real, DNS-resolvable domain. Caddy requests a Let's Encrypt
# certificate for exactly this — it will NOT work for a bare IP.
DOMAIN=

# --- REQUIRED: Database ---
POSTGRES_USER=marketing
POSTGRES_PASSWORD=
POSTGRES_DB=marketing_saas

# --- REQUIRED: Redis (queue + cache) ---
REDIS_PASSWORD=

# --- REQUIRED: Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Usually just https://$DOMAIN — only set this if it needs to differ.
NEXTAUTH_URL=
NEXT_PUBLIC_APP_URL=

# --- Email (SMTP) — optional, falls back to console-logging (dev-mode
# behavior only; see src/lib/integrations/email-provider.ts's production
# guard) if unset. Real campaigns need this configured. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com

# --- SMS — optional, falls back to logging instead of sending if unset ---
SMS_API_URL=
SMS_API_KEY=

# --- LLM Providers — optional individually; leave all blank and AI
# features degrade to heuristic fallbacks (never fabricate a real answer) ---
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
HUGGINGFACE_API_KEY=

# --- Search ---
SERPER_API_KEY=

# --- Vector search (Qdrant) — optional, falls back to in-DB cosine
# similarity if unset ---
QDRANT_URL=
QDRANT_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Crypto payments (NOWPayments — the one real, non-stub gateway) ---
CRYPTO_GATEWAY=nowpayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_WEBHOOK_SECRET=
# Manual-wallet fallback if the gateway call fails (src/lib/payment/crypto.ts)
PLATFORM_WALLET_BTC_BITCOIN=
PLATFORM_WALLET_ETH_ETHEREUM=
PLATFORM_WALLET_USDT_TRON=

# --- Playwright (advanced scraping) — optional ---
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_EXTRACT_REVIEWS=false

# --- Security event forwarding (SIEM) — optional ---
SIEM_WEBHOOK_URL=

# --- Observability (Phase 15) ---
LOG_LEVEL=info
# Critical-error alerts (Slack-incoming-webhook-compatible JSON POST).
# Unset = alerts are still logged locally, just not forwarded anywhere.
ALERT_WEBHOOK_URL=
# Bearer token required to scrape GET /api/metrics. Unset = that endpoint
# refuses every request (security-by-default), not "open with no auth."
METRICS_TOKEN=

# --- Public landing page ---
PUBLIC_LANDING=true
