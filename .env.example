# ============================================================================
# CPPflow Marketing SaaS — Environment Variables
# ============================================================================
# Copy this file to .env (local) or .env.production (production) and fill in.
# ============================================================================

# --- Database ---
# Local dev: SQLite (zero-config)
DATABASE_URL=file:./db/custom.db
# Production: PostgreSQL
# DATABASE_URL=postgresql://marketing:marketing_secret_change_me@localhost:5432/marketing_saas?schema=public

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-long-random-string-at-least-32-chars
# Generate one with: openssl rand -base64 32

# --- LLM Providers (Multi-LLM Aggregator) ---
# At least one is recommended; all have free tiers.
# Sign up: https://console.groq.com/keys (easiest, ultra-fast)
GROQ_API_KEY=
# Sign up: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
# Sign up: https://openrouter.ai/keys (works without key for free models, but lower rate)
OPENROUTER_API_KEY=
# Sign up: https://console.mistral.ai/
MISTRAL_API_KEY=
# Sign up: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# --- Search & Scraping ---
# Serper.dev — Google search API (free tier 2,500 calls/month)
# Sign up: https://serper.dev/
SERPER_API_KEY=

# --- Email (SMTP) ---
# For sending campaigns & notifications. Use Mailtrap for dev, SendGrid/Mailgun for prod.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com

# --- SMS ---
# Any REST gateway that accepts {to, body} + a bearer key (e.g. Kavenegar).
# Without these, src/lib/integrations/sms-provider.ts falls back to logging
# to the console instead of sending — never fabricates a "delivered" status.
SMS_API_URL=
SMS_API_KEY=

# --- Payment Gateways (optional) ---
# Stripe — global cards
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Razorpay — India
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Moyasar — Saudi Arabia
MOYASAR_SECRET_KEY=
# Paystack — Nigeria/Africa
PAYSTACK_SECRET_KEY=
# Crypto (NOWPayments)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_WEBHOOK_SECRET=
CRYPTO_GATEWAY=nowpayments  # or 'manual' for direct wallet payments

# --- Crypto Wallets (for manual crypto payments) ---
# Fill these to accept direct crypto deposits
PLATFORM_WALLET_BTC_BITCOIN=
PLATFORM_WALLET_USDT_TRON=
PLATFORM_WALLET_ETH_ETHEREUM=

# --- Redis (production only — for job queue & rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Vector DB (Qdrant) — optional for semantic search ---
QDRANT_URL=
QDRANT_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Optional Integrations ---
# Playwright (for advanced web scraping)
PLAYWRIGHT_ENABLED=false
# SIEM webhook (for security event forwarding)
SIEM_WEBHOOK_URL=

# --- Observability ---
# debug | info | warn | error. Defaults to 'info' in production, 'debug' otherwise.
LOG_LEVEL=
# Generic JSON webhook (Slack-incoming-webhook compatible) for critical-error
# alerts (unhandled 5xx errors, health check going unhealthy). Unset = alerts
# are still logged locally, just not forwarded anywhere.
ALERT_WEBHOOK_URL=
# Bearer token required to scrape GET /api/metrics (Prometheus format).
# Unset = the endpoint refuses every request (security-by-default) rather
# than serving metrics with no auth at all.
METRICS_TOKEN=

# --- Public Landing Page ---
# Set to 'false' to require login before viewing anything (including /)
PUBLIC_LANDING=true
